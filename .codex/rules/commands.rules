# Commands the project owner has authorized for Codex. Matching commands run without asking.
# Decisions: allow = run; prompt = send to the automatic reviewer; forbidden = never run.
# When two rules match, the strictest one wins (so the forbidden rules below beat the allows).

# --- Git: routine work (commit, branch, push, diff, log) ---
prefix_rule(pattern = ["git"], decision = "allow")
prefix_rule(
    pattern = ["git", "push", "--force"],
    decision = "forbidden",
    justification = "Force-pushing rewrites shared branch history. Ask Dad first.",
)
prefix_rule(
    pattern = ["git", "push", "-f"],
    decision = "forbidden",
    justification = "Force-pushing rewrites shared branch history. Ask Dad first.",
)
prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Discards uncommitted work. Commit or stash first.",
)
prefix_rule(
    pattern = ["git", "clean"],
    decision = "prompt",
    justification = "Deletes untracked files. Confirm which files should go.",
)

# --- GitHub CLI: reads run freely. Anything else (create, comment, edit) is unmatched, so it goes to the
# automatic reviewer (config.toml). Don't add a catch-all gh prompt: it would outrank these allows.
prefix_rule(pattern = ["gh", "pr", "view"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "list"], decision = "allow")
prefix_rule(pattern = ["gh", "pr", "checks"], decision = "allow")
prefix_rule(pattern = ["gh", "run", "view"], decision = "allow")
prefix_rule(pattern = ["gh", "run", "list"], decision = "allow")
prefix_rule(pattern = ["gh", "issue", "view"], decision = "allow")
prefix_rule(pattern = ["gh", "issue", "list"], decision = "allow")
prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "forbidden",
    justification = "Dad merges PRs himself. Stop once the work is pushed.",
)
prefix_rule(
    pattern = ["gh", "pr", "create"],
    decision = "forbidden",
    justification = "Codex doesn't open PRs here. Claude's ship skill does that. Stop once the work is pushed.",
)

# --- Node, npm and project tools ---
prefix_rule(pattern = ["node"], decision = "allow")
prefix_rule(pattern = ["npm", "run"], decision = "allow")
prefix_rule(pattern = ["npm", "ci"], decision = "allow")
prefix_rule(pattern = ["npm", "exec", "--no", "--", "playwright-cli"], decision = "allow")
prefix_rule(pattern = ["npx", "tsc"], decision = "allow")
prefix_rule(pattern = ["npx", "vite"], decision = "allow")
prefix_rule(pattern = ["npx", "playwright"], decision = "allow")
prefix_rule(pattern = ["npx", "playwright-cli"], decision = "allow")
prefix_rule(pattern = ["playwright-cli"], decision = "allow")
prefix_rule(pattern = ["ffmpeg"], decision = "allow")
prefix_rule(pattern = ["ffprobe"], decision = "allow")
prefix_rule(pattern = ["sips"], decision = "allow")

# --- Reading and light file work inside the project ---
prefix_rule(pattern = ["ls"], decision = "allow")
prefix_rule(pattern = ["pwd"], decision = "allow")
prefix_rule(pattern = ["cat"], decision = "allow")
prefix_rule(pattern = ["head"], decision = "allow")
prefix_rule(pattern = ["tail"], decision = "allow")
prefix_rule(pattern = ["wc"], decision = "allow")
prefix_rule(pattern = ["sort"], decision = "allow")
prefix_rule(pattern = ["uniq"], decision = "allow")
prefix_rule(pattern = ["cut"], decision = "allow")
prefix_rule(pattern = ["diff"], decision = "allow")
prefix_rule(pattern = ["file"], decision = "allow")
prefix_rule(pattern = ["stat"], decision = "allow")
prefix_rule(pattern = ["du"], decision = "allow")
prefix_rule(pattern = ["which"], decision = "allow")
prefix_rule(pattern = ["date"], decision = "allow")
prefix_rule(pattern = ["echo"], decision = "allow")
prefix_rule(pattern = ["grep"], decision = "allow")
prefix_rule(pattern = ["rg"], decision = "allow")
prefix_rule(pattern = ["find"], decision = "allow")
prefix_rule(pattern = ["sed"], decision = "allow")
prefix_rule(pattern = ["awk"], decision = "allow")
prefix_rule(pattern = ["jq"], decision = "allow")
prefix_rule(pattern = ["mkdir"], decision = "allow")
prefix_rule(pattern = ["touch"], decision = "allow")
prefix_rule(pattern = ["cp"], decision = "allow")
prefix_rule(pattern = ["mv"], decision = "allow")
prefix_rule(pattern = ["open"], decision = "allow")
prefix_rule(pattern = ["rm"], decision = "prompt", justification = "Deletes files. Confirm what goes.")

# --- Never, whatever the reviewer says ---
prefix_rule(
    pattern = ["rm", "-rf", "/"],
    decision = "forbidden",
    justification = "Would wipe the disk.",
)
prefix_rule(
    pattern = ["rm", "-rf", "~"],
    decision = "forbidden",
    justification = "Would wipe the home folder.",
)
prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "No admin commands from Codex.",
)
