# Only the main GitHub Pages workflow sets VITE_POSTHOG_ENABLED=true.
# Local builds do not send events with these values alone.
VITE_POSTHOG_KEY=your_posthog_project_token
VITE_POSTHOG_HOST=your_posthog_host

# ElevenLabs (sound effects via the MCP, scripts/mcp/elevenlabs.sh). Put the real key in the main checkout's .env.
ELEVENLABS_API_KEY=your_elevenlabs_api_key
