[
  {
    "text": "Unicorn Tea Party",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1591,
    "file": "7bccd6d36bf3.mp3"
  },
  {
    "text": "Kaylee, you did it! You won the Counting Champion trophy!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4271,
    "file": "076fecab06de.mp3"
  },
  {
    "text": "Kaylee, Counting Champion! From Unicorn Tea Party.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4303,
    "file": "6145c93baf40.mp3"
  },
  {
    "text": "Welcome to Sparkle's tea party, Kaylee! Let's count some treats. First, touch and count!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 7982,
    "file": "7f5b17b8cbd4.mp3"
  },
  {
    "text": "Next, move and count!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1994,
    "file": "99576f9361c8.mp3"
  },
  {
    "text": "Now, mark and count!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2489,
    "file": "6bfb94a7925d.mp3"
  },
  {
    "text": "Let's match the numbers!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1717,
    "file": "a8d34d17ba3d.mp3"
  },
  {
    "text": "Time for a quick look!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1519,
    "file": "f25a3a5a2d8d.mp3"
  },
  {
    "text": "Last stop! Are there enough cups?",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3215,
    "file": "38b4fab3317a.mp3"
  },
  {
    "text": "You counted that cupcake already. Tap a different one!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4223,
    "file": "efd7b64a3df4.mp3"
  },
  {
    "text": "You marked that flower already. Pick another one!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3842,
    "file": "e48774a7bc5e.mp3"
  },
  {
    "text": "That friend has a cup already. Give the next cup to someone without one!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4997,
    "file": "cdc5e12bbcc8.mp3"
  },
  {
    "text": "Let's count them together!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1818,
    "file": "08d0ebde9ec0.mp3"
  },
  {
    "text": "How many were there?",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1859,
    "file": "299bdecadae1.mp3"
  },
  {
    "text": "Sparkle loved those hops!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2180,
    "file": "43ac61dc942f.mp3"
  },
  {
    "text": "How many cupcakes did you count?",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2033,
    "file": "78b60835dc3d.mp3"
  },
  {
    "text": "Tap each cupcake, one at a time, and count as you go.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4130,
    "file": "6dab70dfc8ce.mp3"
  },
  {
    "text": "Look at all these cupcakes! Tap each one and count.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4470,
    "file": "676f0fb3c9b0.mp3"
  },
  {
    "text": "Let's count the next group. Tap each cupcake once.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 5340,
    "file": "c035460172d8.mp3"
  },
  {
    "text": "How many stars are in the teapot?",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2451,
    "file": "1c7d937ac737.mp3"
  },
  {
    "text": "Drag each star into the teapot, counting as you go.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3722,
    "file": "5fda82402895.mp3"
  },
  {
    "text": "Let's fill the teapot with stars! Count as you move them.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4315,
    "file": "482fb6ca3dbf.mp3"
  },
  {
    "text": "Move the next stars into the teapot and count them.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3923,
    "file": "f59f12e64c8d.mp3"
  },
  {
    "text": "How many flowers did you mark?",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2247,
    "file": "b2da4c344871.mp3"
  },
  {
    "text": "These flowers won't move, so mark each one as you count.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4060,
    "file": "7125797b813b.mp3"
  },
  {
    "text": "A big bouquet! Mark each flower and count as you go.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4462,
    "file": "1db6139d77de.mp3"
  },
  {
    "text": "Here is another bouquet. Mark each flower and count.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4914,
    "file": "5be1176ceca5.mp3"
  },
  {
    "text": "How many dots do you see? Tap the matching number.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4568,
    "file": "b18d48ba59d7.mp3"
  },
  {
    "text": "Bonus card! Count the dots and find their number.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3991,
    "file": "ccaaf0591df5.mp3"
  },
  {
    "text": "Let's play a quick look game. I'll show the dots for two seconds, then you tell me how many you saw.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 6955,
    "file": "46bb9104f3ee.mp3"
  },
  {
    "text": "Ready for another quick look?",
