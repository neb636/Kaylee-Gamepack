    "sig": "ed7dbdac3d",
    "ms": 3974,
    "file": "965d4aa4c6d2.mp3"
  },
  {
    "text": "Where should we fly?",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1488,
    "file": "23378671c3a5.mp3"
  },
  {
    "text": "Up, up and away!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1999,
    "file": "6f0c88638a1f.mp3"
  },
  {
    "text": "That's North America!",
