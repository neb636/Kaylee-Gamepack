[
  {
    "text": "Around the World!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1976,
    "file": "3bb97b151bd4.mp3"
  },
  {
    "text": "Let's fly around the world, Kaylee! Tap the sparkly pin.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3974,
    "file": "965d4aa4c6d2.mp3"
  },
  {
    "text": "Where should we fly, Kaylee?",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2319,
    "file": "afd76fcdbf71.mp3"
  },
  {
    "text": "Up, up and away!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1999,
    "file": "6f0c88638a1f.mp3"
  },
  {
    "text": "That's North America!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2378,
    "file": "b7df37c6a637.mp3"
  },
  {
    "text": "That's South America!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1469,
    "file": "50398fdf7202.mp3"
  },
  {
    "text": "That's Europe!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1359,
    "file": "d6531a7b1537.mp3"
  },
  {
    "text": "That's Africa!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1442,
    "file": "505e864a15a5.mp3"
  },
  {
    "text": "That's Asia! It's the biggest continent.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3456,
    "file": "47574fe73de6.mp3"
  },
  {
    "text": "That's Australia! It's a country and a continent.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4860,
    "file": "b5008799c5a3.mp3"
  },
  {
    "text": "That's Antarctica! Brrr, it's icy!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4242,
    "file": "fd9d2c2c836f.mp3"
  },
  {
    "text": "This is home!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1411,
    "file": "cc3fbb839d61.mp3"
  },
  {
    "text": "We'll fly to Egypt soon! It has pyramids!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4377,
    "file": "28d4d1287874.mp3"
  },
  {
    "text": "We'll fly to China soon! It has pandas!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4065,
    "file": "541a047b1f47.mp3"
  },
  {
    "text": "We'll fly to Thailand soon! It has elephants!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4376,
    "file": "0391e0b86cdb.mp3"
  },
  {
    "text": "This is your passport, Kaylee! Every stamp is a place you helped.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 5279,
    "file": "594483aadfbd.mp3"
  },
  {
    "text": "Fly to more places to fill your passport!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3314,
    "file": "10bd5086995d.mp3"
  },
  {
    "text": "Pick a page to color!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1850,
    "file": "30547069102c.mp3"
  },
  {
    "text": "Pick a color, then tap to paint!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2810,
    "file": "52b75b269ef9.mp3"
  },
  {
