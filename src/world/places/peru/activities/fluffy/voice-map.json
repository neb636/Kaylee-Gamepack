[
  {
    "text": "My cozy alpaca family!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2294,
    "file": "07818277ebd4.mp3"
  },
  {
    "text": "My fleece is so long, I can't see!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2957,
    "file": "c5d1c4a2be37.mp3"
  },
  {
    "text": "Brush Luna's fleece, Kaylee!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3013,
    "file": "dc5c9420a7d9.mp3"
  },
  {
    "text": "Ouch! Prickly!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1389,
    "file": "e3e146a8b10c.mp3"
  },
  {
    "text": "A twig!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 759,
    "file": "1c449a266d70.mp3"
  },
  {
    "text": "Achoo!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 530,
    "file": "ff204fe0637a.mp3"
  },
  {
    "text": "A baby bird!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1180,
    "file": "f776bca89a5b.mp3"
  },
  {
    "text": "Bye-bye, beetle!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 944,
    "file": "5ed174fb2d51.mp3"
  },
  {
    "text": "I can see you, Kaylee!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1972,
    "file": "937c72fb8d5c.mp3"
  },
  {
    "text": "Alpacas hum when they are happy!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2388,
    "file": "5b31e89f274b.mp3"
  },
  {
    "text": "Now the clippers! Snip snip!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2570,
    "file": "840b776639f0.mp3"
  },
  {
    "text": "Done? Tap the pond to show Luna!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3682,
    "file": "7d7a9ac3feda.mp3"
  },
  {
    "text": "Hee hee! A mustache!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1708,
    "file": "2800b512eb70.mp3"
  },
  {
    "text": "I look so silly!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1604,
    "file": "76442d1b8527.mp3"
  },
  {
    "text": "So pretty!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1211,
    "file": "8316576f1c5b.mp3"
  },
  {
    "text": "Brrr! Hat please!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2466,
    "file": "84cf1411aa12.mp3"
  },
  {
    "text": "Brrr! It's chilly up here!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2742,
    "file": "fb1b1408b3a8.mp3"
  },
  {
    "text": "Me next! Me next!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 1879,
    "file": "ee3aeb028b6a.mp3"
  },
  {
    "text": "My turn, dear.",
    "voice": "abuela",
    "sig": "6d0b923627",
    "ms": 1475,
    "file": "e3d00b479ad2.mp3"
  },
  {
    "text": "Paco and Abuela want haircuts too!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4208,
    "file": "98e90d7f2da6.mp3"
  },
  {
    "text": "Hee hee! That tickles!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 1881,
    "file": "a81d5921967b.mp3"
  },
  {
    "text": "Not my tummy!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 1598,
    "file": "27b1c25d80b7.mp3"
  },
  {
    "text": "Ha ha ha!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 1044,
    "file": "74b8c2fac4f1.mp3"
  },
  {
    "text": "Too tickly!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 1015,
    "file": "c25b8a91cacf.mp3"
  },
  {
    "text": "Oh, I am so sleepy...",
    "voice": "abuela",
    "sig": "6d0b923627",
    "ms": 3406,
    "file": "7f8273064990.mp3"
  },
  {
    "text": "Five more minutes...",
    "voice": "abuela",
    "sig": "6d0b923627",
    "ms": 1830,
    "file": "511f46be93ab.mp3"
  },
  {
    "text": "Brrr! Chilly!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 2269,
    "file": "e1b1cf38ad26.mp3"
  },
  {
    "text": "Oh my! Brrr!",
    "voice": "abuela",
    "sig": "6d0b923627",
    "ms": 2684,
    "file": "e59437299f3a.mp3"
  },
  {
    "text": "The wool is yarn now! Tap the cactus!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3640,
    "file": "b702d696db3c.mp3"
  },
  {
    "text": "A tiny bug makes pink color!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3101,
    "file": "f23ea0c8e2bb.mp3"
  },
  {
    "text": "Drag the pink drop to the yarn!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2594,
    "file": "2246b4fbb4f7.mp3"
  },
  {
    "text": "Pink yarn! Pink hats!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2738,
    "file": "f93e3e9f1bf4.mp3"
  },
  {
    "text": "Put a warm hat on each alpaca!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3387,
    "file": "72b19f1e0e00.mp3"
  },
  {
    "text": "Cozy!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1012,
    "file": "cc0acfe156c4.mp3"
  },
  {
    "text": "Yay! Warm ears!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 2064,
    "file": "a0832ffb739a.mp3"
  },
  {
    "text": "Thank you, dear!",
    "voice": "abuela",
    "sig": "6d0b923627",
    "ms": 1160,
    "file": "f02a1a21f0e8.mp3"
  },
  {
    "text": "Click! A picture for my journal!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2385,
    "file": "15431e0b1b84.mp3"
  },
  {
    "text": "Alpacas come in lots of colors!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2582,
    "file": "c199d0f4d576.mp3"
  },
  {
    "text": "Rub the brush on Luna's fleece!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2367,
    "file": "669b45e79699.mp3"
  },
  {
    "text": "Snip the fluffy puffs!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1995,
    "file": "1424a22023b7.mp3"
  },
  {
    "text": "Tap the cactus!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1934,
    "file": "7a19dcae5ffd.mp3"
  },
  {
    "text": "Drag a hat onto an alpaca!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2546,
    "file": "b46f7505e913.mp3"
  },
  {
    "text": "Alpaca sticker! Alpacas have soft, warm fleece!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4722,
    "file": "fbb401e41c19.mp3"
  }
]
