[
  {
    "text": "My chick Pluma is scared to fly.",
    "voice": "coco",
    "sig": "794c66c94c",
    "ms": 3317,
    "file": "e4b9ef60bd2c.mp3"
  },
  {
    "text": "Grab Coco and show her how!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2542,
    "file": "3dd09b1e0083.mp3"
  },
  {
    "text": "Fly into the warm air!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1895,
    "file": "8186a59ae473.mp3"
  },
  {
    "text": "Ahh, warm air! Up we go!",
    "voice": "coco",
    "sig": "794c66c94c",
    "ms": 3716,
    "file": "5a9f07718e28.mp3"
  },
  {
    "text": "I need warm air to go up!",
    "voice": "coco",
    "sig": "794c66c94c",
    "ms": 2788,
    "file": "e4da24e55582.mp3"
  },
  {
    "text": "Whoooosh!",
    "voice": "coco",
    "sig": "794c66c94c",
    "ms": 1137,
    "file": "5bf49a2af09c.mp3"
  },
  {
    "text": "Achoo!",
    "voice": "coco",
    "sig": "794c66c94c",
    "ms": 674,
    "file": "cd42bb8f4721.mp3"
  },
  {
    "text": "It's so high!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 1493,
    "file": "7933ed52ec1d.mp3"
  },
  {
    "text": "Come on, Pluma! Fly with me!",
    "voice": "coco",
    "sig": "794c66c94c",
    "ms": 2941,
    "file": "cb48bd84b2a0.mp3"
  },
  {
    "text": "I'll try! Here I come!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 2115,
    "file": "892486cad6c9.mp3"
  },
  {
    "text": "Lead Pluma to the shiny circles!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3555,
    "file": "601e95ffea16.mp3"
  },
  {
    "text": "Wait for me!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 996,
    "file": "d6fc6a56d8f1.mp3"
  },
  {
    "text": "Wheee!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 973,
    "file": "03354a2a9585.mp3"
  },
  {
    "text": "I'm dizzy!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 970,
    "file": "01b17fbbe505.mp3"
  },
  {
    "text": "Ooh, a waterfall!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 2883,
    "file": "a5c52b6186e0.mp3"
  },
  {
    "text": "Hello, friends!",
    "voice": "coco",
    "sig": "794c66c94c",
    "ms": 1130,
    "file": "dfad6ba7fd08.mp3"
  },
  {
    "text": "People are waving!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 1507,
    "file": "c66cbf60b58b.mp3"
  },
  {
    "text": "Smile for the photo!",
    "voice": "coco",
    "sig": "794c66c94c",
    "ms": 1549,
    "file": "6f4b3546250f.mp3"
  },
  {
    "text": "The sun moved! Find the new warm air!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3318,
    "file": "1292939bcd17.mp3"
  },
  {
    "text": "Fly to the very top!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1731,
    "file": "205b38fc63d2.mp3"
  },
  {
    "text": "I can fly by myself!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 2131,
    "file": "bd247b542184.mp3"
  },
  {
    "text": "Now you fly Pluma, Kaylee!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3171,
    "file": "a1c7849b7744.mp3"
  },
  {
    "text": "Fly Pluma into the big swirl!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3447,
    "file": "417db67935b0.mp3"
  },
  {
    "text": "Look at me, Kaylee!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 1498,
    "file": "bf95d8cafcd4.mp3"
  },
  {
    "text": "My Pluma can fly! Gracias, Kaylee!",
    "voice": "coco",
    "sig": "794c66c94c",
    "ms": 3885,
    "file": "d27c4b7b43d2.mp3"
  },
  {
    "text": "Click! A picture for Luna's journal!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2702,
    "file": "73df44cc1cba.mp3"
  },
  {
    "text": "Hi, Dad!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 981,
    "file": "47490d45a1be.mp3"
  },
  {
    "text": "Grab Coco and fly!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2304,
    "file": "c58568c8ff33.mp3"
  },
  {
    "text": "Fly to a shiny circle!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1955,
    "file": "41f93b65aeb3.mp3"
  },
  {
    "text": "Condors hardly flap their wings!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2831,
    "file": "3c27f5abc035.mp3"
  },
  {
    "text": "Condor wings are wider than a grown-up is tall!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3399,
    "file": "b5d32ed6b684.mp3"
  },
  {
    "text": "This canyon is super deep!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2822,
    "file": "3b31b3642841.mp3"
  },
  {
    "text": "The sun warms the air, and warm air rises!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4650,
    "file": "e3110b3cb611.mp3"
  },
  {
    "text": "I can fly!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 1047,
    "file": "40f47095cbee.mp3"
  },
  {
    "text": "Condor sticker! Condors soar on warm air!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 5636,
    "file": "9dc627ad3d0c.mp3"
  }
]
