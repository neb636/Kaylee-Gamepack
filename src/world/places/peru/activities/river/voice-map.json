    "sig": "ed7dbdac3d",
    "ms": 2023,
    "file": "22f930c422fb.mp3"
  },
  {
    "text": "Make it rain on the river!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1899,
    "file": "01d9b3bc0471.mp3"
  },
  {
    "text": "Wheee! More water!",
    "voice": "rosa",
    "sig": "795618f009",
    "ms": 2354,
    "file": "a9b2bd8dbbe9.mp3"
  },
  {
    "text": "Hola, capybaras!",
    "voice": "rosa",
    "sig": "795618f009",
    "ms": 1710,
    "file": "68659c75b6dd.mp3"
  },
  {
    "text": "Ahh... a swim!",
    "voice": "capy",
    "sig": "772878d955",
    "ms": 2093,
    "file": "c13c0b018c6a.mp3"
  },
  {
    "text": "Hola, sloth!",
    "voice": "rosa",
    "sig": "795618f009",
    "ms": 1670,
    "file": "07131f97c0b7.mp3"
  },
  {
    "text": "Hiii, Rosa...",
    "voice": "sloth",
    "sig": "1a6320a9e1",
    "ms": 1502,
    "file": "e190d8cbf8ed.mp3"
  },
  {
    "text": "Hola, monkeys!",
    "voice": "rosa",
    "sig": "795618f009",
    "ms": 1671,
    "file": "f0f36d2f7f3c.mp3"
  },
  {
    "text": "Splash! Splash!",
    "voice": "monkey",
    "sig": "5eefd2db79",
    "ms": 1701,
    "file": "650d25941512.mp3"
  },
  {
    "text": "The river grows into the forest!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3030,
    "file": "d937a06963af.mp3"
  },
  {
    "text": "Let's swim to the lagoon!",
    "voice": "rosa",
    "sig": "795618f009",
    "ms": 1555,
    "file": "fba5d9ca088b.mp3"
  },
  {
    "text": "Rain on the lagoon!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1551,
    "file": "f16bdd7ea297.mp3"
  },
  {
    "text": "Rain on the lily buds!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2550,
    "file": "1d05dc7f0d2f.mp3"
  },
  {
    "text": "Lily pads! Help the friends hop on!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4058,
    "file": "87e3b3985f88.mp3"
  },
  {
    "text": "Hop, frog!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1260,
    "file": "1a30cb1ec6db.mp3"
  },
  {
    "text": "Wheee!",
    "voice": "monkey",
    "sig": "5eefd2db79",
    "ms": 1062,
    "file": "c186dc222372.mp3"
