[
  {
    "text": "My rainbow river!",
    "voice": "rosa",
    "sig": "795618f009",
    "ms": 1605,
    "file": "78a931cc7976.mp3"
  },
  {
    "text": "Hola! I want to visit my forest friends!",
    "voice": "rosa",
    "sig": "795618f009",
    "ms": 3245,
    "file": "2bb37a69c93d.mp3"
  },
  {
    "text": "Squeeze the cloud to make rain!",
