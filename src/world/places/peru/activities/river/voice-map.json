    "sig": "ed7dbdac3d",
    "ms": 2407,
    "file": "b8dfe53850db.mp3"
  },
  {
    "text": "Bye-bye, cloud! Hello, sun!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2388,
    "file": "031864b9dce7.mp3"
  },
  {
    "text": "A rainbow! Gracias, Kaylee!",
    "voice": "rosa",
    "sig": "795618f009",
    "ms": 2567,
    "file": "d01670fb5b82.mp3"
  },
  {
    "text": "Click! A picture for Luna!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2138,
    "file": "471637c6e1f9.mp3"
  },
  {
    "text": "Hee hee!",
    "voice": "rosa",
    "sig": "795618f009",
    "ms": 458,
    "file": "f2c19e27a2b4.mp3"
  },
  {
    "text": "Pfff! Bubbles!",
    "voice": "rosa",
    "sig": "795618f009",
    "ms": 1622,
    "file": "f8d17a72d598.mp3"
  },
  {
    "text": "Splashy!",
    "voice": "rosa",
    "sig": "795618f009",
    "ms": 883,
    "file": "a53101930f40.mp3"
  },
  {
    "text": "I live in a river, not the sea!",
    "voice": "rosa",
    "sig": "795618f009",
    "ms": 2249,
    "file": "db8a1dde10db.mp3"
  },
  {
    "text": "This dolphin lives in a river!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2614,
    "file": "17c815be5384.mp3"
  },
  {
    "text": "Half of Peru is rainforest!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2901,
    "file": "f7e2d8ad8051.mp3"
  },
  {
    "text": "Some fish eat fruit!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2600,
    "file": "7c731e4abe09.mp3"
  },
  {
    "text": "Hold the cloud to make rain!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2538,
    "file": "45885f9e936c.mp3"
  },
  {
    "text": "Drag the cloud over the river!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2718,
    "file": "884064cdcbfe.mp3"
  },
  {
    "text": "Drag the cloud over the lagoon!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2423,
    "file": "ac547780388d.mp3"
  },
  {
    "text": "Drag a friend onto a lily pad!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2711,
    "file": "495ad7babe29.mp3"
  },
  {
    "text": "Pink dolphin sticker! These dolphins live in rivers!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4707,
