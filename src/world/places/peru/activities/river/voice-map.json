    "sig": "1a6320a9e1",
    "ms": 2558,
    "file": "df0e38f0f6de.mp3"
  },
  {
    "text": "Ooh... a shower...",
    "voice": "sloth",
    "sig": "1a6320a9e1",
    "ms": 2629,
    "file": "46f72f3f609b.mp3"
  },
  {
    "text": "I'm all wet! Hee hee!",
