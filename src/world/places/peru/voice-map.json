[
  {
    "text": "Peru",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 677,
    "file": "07e04325fe70.mp3"
  },
  {
    "text": "Kaylee, you did it! You won the Peru Explorer trophy!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4751,
    "file": "9ceadef5975f.mp3"
  },
  {
    "text": "Kaylee, Peru Explorer! From Peru.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4574,
    "file": "46b37a8b8b1e.mp3"
  },
  {
    "text": "Hola, Kaylee! I'm Luna!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2048,
    "file": "480495cdd2a4.mp3"
  },
  {
    "text": "Let's fill my explorer journal!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2194,
    "file": "40416dcdfe6e.mp3"
  },
  {
    "text": "Tap a picture to explore Peru!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2834,
    "file": "25e8872981a6.mp3"
  },
  {
    "text": "Another discovery, Kaylee!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2114,
    "file": "bef51fccef7f.mp3"
  },
  {
    "text": "This place opens soon!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1818,
    "file": "7383ac54928f.mp3"
  },
  {
    "text": "Our balloon trip comes soon!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2690,
    "file": "b340c9d6e692.mp3"
  },
  {
    "text": "Hee hee!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 956,
    "file": "739a4d92b706.mp3"
  },
  {
    "text": "I love exploring with you!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1712,
    "file": "e28a2924a025.mp3"
  },
  {
    "text": "My explorer journal!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1811,
    "file": "fe661d7e1416.mp3"
  },
  {
    "text": "My cozy alpaca family!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2294,
    "file": "07818277ebd4.mp3"
  },
  {
    "text": "My fluffy chicks!",
    "voice": "pepa",
    "sig": "5bda623ab7",
    "ms": 1976,
    "file": "3de6b1a162f0.mp3"
  },
  {
    "text": "My rainbow river!",
    "voice": "rosa",
    "sig": "795618f009",
    "ms": 1605,
    "file": "78a931cc7976.mp3"
  },
  {
    "text": "By the sea, Peru has a sandy desert!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4217,
    "file": "76e44b3818dd.mp3"
  },
  {
    "text": "The Andes mountains are tall and cold!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3883,
    "file": "b5a0a775478a.mp3"
  },
  {
    "text": "Half of Peru is rainforest!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2901,
    "file": "f7e2d8ad8051.mp3"
  },
  {
    "text": "My fleece is so long, I can't see!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2957,
    "file": "c5d1c4a2be37.mp3"
  },
  {
    "text": "Brush Luna's fleece, Kaylee!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3013,
    "file": "dc5c9420a7d9.mp3"
  },
  {
    "text": "Ouch! Prickly!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1389,
    "file": "e3e146a8b10c.mp3"
  },
  {
    "text": "A twig!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 759,
    "file": "1c449a266d70.mp3"
  },
  {
    "text": "Achoo!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 530,
    "file": "ff204fe0637a.mp3"
  },
  {
    "text": "A baby bird!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1180,
    "file": "f776bca89a5b.mp3"
  },
  {
    "text": "Bye-bye, beetle!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 944,
    "file": "5ed174fb2d51.mp3"
  },
  {
    "text": "I can see you, Kaylee!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1972,
    "file": "937c72fb8d5c.mp3"
  },
  {
    "text": "Alpacas hum when they are happy!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2388,
    "file": "5b31e89f274b.mp3"
  },
  {
    "text": "Now the clippers! Snip snip!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2570,
    "file": "840b776639f0.mp3"
  },
  {
    "text": "Done? Tap the pond to show Luna!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3682,
    "file": "7d7a9ac3feda.mp3"
  },
  {
    "text": "Hee hee! A mustache!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1708,
    "file": "2800b512eb70.mp3"
  },
  {
    "text": "I look so silly!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1604,
    "file": "76442d1b8527.mp3"
  },
  {
    "text": "So pretty!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1211,
    "file": "8316576f1c5b.mp3"
  },
  {
    "text": "Brrr! Hat please!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2466,
    "file": "84cf1411aa12.mp3"
  },
  {
    "text": "Brrr! It's chilly up here!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2742,
    "file": "fb1b1408b3a8.mp3"
  },
  {
    "text": "Me next! Me next!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 1879,
    "file": "ee3aeb028b6a.mp3"
  },
  {
    "text": "My turn, dear.",
    "voice": "abuela",
    "sig": "6d0b923627",
    "ms": 1475,
    "file": "e3d00b479ad2.mp3"
  },
  {
    "text": "Paco and Abuela want haircuts too!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4208,
    "file": "98e90d7f2da6.mp3"
  },
  {
    "text": "Hee hee! That tickles!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 1881,
    "file": "a81d5921967b.mp3"
  },
  {
    "text": "Not my tummy!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 1598,
    "file": "27b1c25d80b7.mp3"
  },
  {
    "text": "Ha ha ha!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 1044,
    "file": "74b8c2fac4f1.mp3"
  },
  {
    "text": "Too tickly!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 1015,
    "file": "c25b8a91cacf.mp3"
  },
  {
    "text": "Oh, I am so sleepy...",
    "voice": "abuela",
    "sig": "6d0b923627",
    "ms": 3406,
    "file": "7f8273064990.mp3"
  },
  {
    "text": "Five more minutes...",
    "voice": "abuela",
    "sig": "6d0b923627",
    "ms": 1830,
    "file": "511f46be93ab.mp3"
  },
  {
    "text": "Brrr! Chilly!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 2269,
    "file": "e1b1cf38ad26.mp3"
  },
  {
    "text": "Oh my! Brrr!",
    "voice": "abuela",
    "sig": "6d0b923627",
    "ms": 2684,
    "file": "e59437299f3a.mp3"
  },
  {
    "text": "The wool is yarn now! Tap the cactus!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3640,
    "file": "b702d696db3c.mp3"
  },
  {
    "text": "A tiny bug makes pink color!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3101,
    "file": "f23ea0c8e2bb.mp3"
  },
  {
    "text": "Drag the pink drop to the yarn!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2594,
    "file": "2246b4fbb4f7.mp3"
  },
  {
    "text": "Pink yarn! Pink hats!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2738,
    "file": "f93e3e9f1bf4.mp3"
  },
  {
    "text": "Put a warm hat on each alpaca!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3387,
    "file": "72b19f1e0e00.mp3"
  },
  {
    "text": "Cozy!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1012,
    "file": "cc0acfe156c4.mp3"
  },
  {
    "text": "Yay! Warm ears!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 2064,
    "file": "a0832ffb739a.mp3"
  },
  {
    "text": "Thank you, dear!",
    "voice": "abuela",
    "sig": "6d0b923627",
    "ms": 1160,
    "file": "f02a1a21f0e8.mp3"
  },
  {
    "text": "Click! A picture for my journal!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2385,
    "file": "15431e0b1b84.mp3"
  },
  {
    "text": "Alpacas come in lots of colors!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2582,
    "file": "c199d0f4d576.mp3"
  },
  {
    "text": "Rub the brush on Luna's fleece!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2367,
    "file": "669b45e79699.mp3"
  },
  {
    "text": "Snip the fluffy puffs!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1995,
    "file": "1424a22023b7.mp3"
  },
  {
    "text": "Tap the cactus!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1934,
    "file": "7a19dcae5ffd.mp3"
  },
  {
    "text": "Drag a hat onto an alpaca!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2546,
    "file": "b46f7505e913.mp3"
  },
  {
    "text": "Hola! My chicks are hungry!",
    "voice": "pepa",
    "sig": "5bda623ab7",
    "ms": 2346,
    "file": "c5a94f011efc.mp3"
  },
  {
    "text": "Pull a penguin back, then let go!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2896,
    "file": "7e1fc97c0fcb.mp3"
  },
  {
    "text": "Wheee!",
    "voice": "pingo",
    "sig": "59d0d06102",
    "ms": 1436,
    "file": "6c8abeada84e.mp3"
  },
  {
    "text": "Splash!",
    "voice": "pingo",
    "sig": "59d0d06102",
    "ms": 1058,
    "file": "f4de41918e01.mp3"
  },
  {
    "text": "Yippee!",
    "voice": "pingo",
    "sig": "59d0d06102",
    "ms": 634,
    "file": "daedfba94fea.mp3"
  },
  {
    "text": "Whoa!",
    "voice": "pingo",
    "sig": "59d0d06102",
    "ms": 580,
    "file": "5f16b15bbaed.mp3"
  },
  {
    "text": "A teeny splash!",
    "voice": "pingo",
    "sig": "59d0d06102",
    "ms": 1755,
    "file": "df3dcbdb9d51.mp3"
  },
  {
    "text": "I found a sock!",
    "voice": "pingo",
    "sig": "59d0d06102",
    "ms": 2151,
    "file": "42f1bfeae5fe.mp3"
  },
  {
    "text": "Hey! You splashed me!",
    "voice": "lobo",
    "sig": "1ae02eaef4",
    "ms": 2350,
    "file": "0f90a33abed2.mp3"
  },
  {
    "text": "Do it again!",
    "voice": "lobo",
    "sig": "1ae02eaef4",
    "ms": 950,
    "file": "a816bd904f22.mp3"
  },
  {
    "text": "Ha ha! Seaweed hat!",
    "voice": "lobo",
    "sig": "1ae02eaef4",
    "ms": 2455,
    "file": "20ee9d732732.mp3"
  },
  {
    "text": "Arf arf!",
    "voice": "lobo",
    "sig": "1ae02eaef4",
    "ms": 997,
    "file": "98e202bc2ef3.mp3"
  },
  {
    "text": "I love splashes!",
    "voice": "lobo",
    "sig": "1ae02eaef4",
    "ms": 2155,
    "file": "0a7de1e550ba.mp3"
  },
  {
    "text": "Hola, Kaylee!",
    "voice": "lobo",
    "sig": "1ae02eaef4",
    "ms": 1860,
    "file": "c85435da8d16.mp3"
  },
  {
    "text": "Jump near the shiny fish!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2013,
    "file": "68e30223edb2.mp3"
  },
  {
    "text": "One fish, please!",
    "voice": "pepa",
    "sig": "5bda623ab7",
    "ms": 1736,
    "file": "34ccaf5db543.mp3"
  },
  {
    "text": "Two fish, please!",
    "voice": "pepa",
    "sig": "5bda623ab7",
    "ms": 1667,
    "file": "d17b24bcfd56.mp3"
  },
  {
    "text": "Three fish, please!",
    "voice": "pepa",
    "sig": "5bda623ab7",
    "ms": 1904,
    "file": "9e9f1901936e.mp3"
  },
  {
    "text": "One!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 645,
    "file": "87ed107b16cf.mp3"
  },
  {
    "text": "Two!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 541,
    "file": "e53b779eaf65.mp3"
  },
  {
    "text": "Three!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 722,
    "file": "b98340c9d88a.mp3"
  },
  {
    "text": "Feed my chicks, Kaylee!",
    "voice": "pepa",
    "sig": "5bda623ab7",
    "ms": 1617,
    "file": "bda8367837fd.mp3"
  },
  {
    "text": "Yummy!",
    "voice": "pepa",
    "sig": "5bda623ab7",
    "ms": 720,
    "file": "1ab0b570b22e.mp3"
  },
  {
    "text": "So round and fluffy!",
    "voice": "pepa",
    "sig": "5bda623ab7",
    "ms": 2061,
    "file": "453a7103ddc0.mp3"
  },
  {
    "text": "Gracias!",
    "voice": "pepa",
    "sig": "5bda623ab7",
    "ms": 894,
    "file": "748b0882b170.mp3"
  },
  {
    "text": "Kaylee, look! The egg is wiggling!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3334,
    "file": "3a4d330c3a0e.mp3"
  },
  {
    "text": "A new baby!",
    "voice": "pepa",
    "sig": "5bda623ab7",
    "ms": 1442,
    "file": "18842a633f79.mp3"
  },
  {
    "text": "A pelican wants fish too!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2661,
    "file": "a92c175ae702.mp3"
  },
  {
    "text": "The chicks are ready to swim! Pull them back!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3331,
    "file": "380b1700e2f4.mp3"
  },
  {
    "text": "Their very first swim!",
    "voice": "pepa",
    "sig": "5bda623ab7",
    "ms": 1699,
    "file": "1d22f0a5fcfa.mp3"
  },
  {
    "text": "Gracias, Kaylee!",
    "voice": "pepa",
    "sig": "5bda623ab7",
    "ms": 1080,
    "file": "e5df440efe89.mp3"
  },
  {
    "text": "Click! A picture for Luna's journal!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2702,
    "file": "73df44cc1cba.mp3"
  },
  {
    "text": "Hola, Kaylee!",
    "voice": "pepa",
    "sig": "5bda623ab7",
    "ms": 1437,
    "file": "054456522459.mp3"
  },
  {
    "text": "My babies love fish!",
    "voice": "pepa",
    "sig": "5bda623ab7",
    "ms": 2045,
    "file": "d5d3fe16bfcd.mp3"
  },
  {
    "text": "These birds have white mustaches!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2846,
    "file": "12d2f3a87ca8.mp3"
  },
  {
    "text": "Peru has penguins!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1809,
    "file": "5d40ec847595.mp3"
  },
  {
    "text": "The ocean here is cold and full of fish!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3643,
    "file": "bfea771b7797.mp3"
  },
  {
    "text": "Penguins fly underwater with their wings!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2692,
    "file": "3d9bc79f59d2.mp3"
  },
  {
    "text": "Tap a chick to feed it!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1856,
    "file": "da3f4ad11897.mp3"
  },
  {
    "text": "Pull a chick back, then let go!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4138,
    "file": "ede35d8e705b.mp3"
  },
  {
    "text": "Penguin sticker! Penguins live in Peru too!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3857,
    "file": "11dba6a857df.mp3"
  },
  {
    "text": "My chick Pluma is scared to fly.",
    "voice": "coco",
    "sig": "794c66c94c",
    "ms": 3317,
    "file": "e4b9ef60bd2c.mp3"
  },
  {
    "text": "Grab Coco and show her how!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2542,
    "file": "3dd09b1e0083.mp3"
  },
  {
    "text": "Fly into the warm air!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1895,
    "file": "8186a59ae473.mp3"
  },
  {
    "text": "Ahh, warm air! Up we go!",
    "voice": "coco",
    "sig": "794c66c94c",
    "ms": 3716,
    "file": "5a9f07718e28.mp3"
  },
  {
    "text": "I need warm air to go up!",
    "voice": "coco",
    "sig": "794c66c94c",
    "ms": 2788,
    "file": "e4da24e55582.mp3"
  },
  {
    "text": "Whoooosh!",
    "voice": "coco",
    "sig": "794c66c94c",
    "ms": 1137,
    "file": "5bf49a2af09c.mp3"
  },
  {
    "text": "Achoo!",
    "voice": "coco",
    "sig": "794c66c94c",
    "ms": 674,
    "file": "cd42bb8f4721.mp3"
  },
  {
    "text": "It's so high!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 1493,
    "file": "7933ed52ec1d.mp3"
  },
  {
    "text": "Come on, Pluma! Fly with me!",
    "voice": "coco",
    "sig": "794c66c94c",
    "ms": 2941,
    "file": "cb48bd84b2a0.mp3"
  },
  {
    "text": "I'll try! Here I come!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 2115,
    "file": "892486cad6c9.mp3"
  },
  {
    "text": "Lead Pluma to the shiny circles!",
