[
  {
    "text": "Peru",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 677,
    "file": "07e04325fe70.mp3"
  },
  {
    "text": "Kaylee, you did it! You won the Peru Explorer trophy!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4751,
    "file": "9ceadef5975f.mp3"
  },
  {
    "text": "Kaylee, Peru Explorer! From Peru.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4574,
    "file": "46b37a8b8b1e.mp3"
  },
  {
    "text": "Hola, Kaylee! I'm Luna!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2048,
    "file": "480495cdd2a4.mp3"
  },
  {
    "text": "Let's fill my explorer journal!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2194,
    "file": "40416dcdfe6e.mp3"
  },
  {
    "text": "Tap a picture to explore Peru!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2834,
    "file": "25e8872981a6.mp3"
  },
  {
    "text": "Another discovery, Kaylee!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2114,
    "file": "bef51fccef7f.mp3"
  },
  {
    "text": "This place opens soon!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1818,
    "file": "7383ac54928f.mp3"
  },
  {
    "text": "Our balloon trip comes soon!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2690,
    "file": "b340c9d6e692.mp3"
  },
  {
    "text": "Hee hee!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 956,
    "file": "739a4d92b706.mp3"
  },
  {
    "text": "I love exploring with you!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1712,
    "file": "e28a2924a025.mp3"
  },
  {
    "text": "My explorer journal!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1811,
    "file": "fe661d7e1416.mp3"
  },
  {
    "text": "My cozy alpaca family!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2294,
    "file": "07818277ebd4.mp3"
  },
  {
    "text": "By the sea, Peru has a sandy desert!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4217,
    "file": "76e44b3818dd.mp3"
  },
  {
    "text": "The Andes mountains are tall and cold!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3883,
    "file": "b5a0a775478a.mp3"
  },
  {
    "text": "Half of Peru is rainforest!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2901,
    "file": "f7e2d8ad8051.mp3"
  },
  {
    "text": "My fleece is so long, I can't see!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2957,
    "file": "c5d1c4a2be37.mp3"
  },
  {
    "text": "Brush Luna's fleece, Kaylee!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3013,
    "file": "dc5c9420a7d9.mp3"
  },
  {
    "text": "Ouch! Prickly!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1389,
    "file": "e3e146a8b10c.mp3"
  },
  {
    "text": "A twig!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 759,
    "file": "1c449a266d70.mp3"
  },
  {
    "text": "Achoo!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 530,
    "file": "ff204fe0637a.mp3"
  },
  {
    "text": "A baby bird!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1180,
    "file": "f776bca89a5b.mp3"
  },
  {
    "text": "Bye-bye, beetle!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 944,
    "file": "5ed174fb2d51.mp3"
  },
  {
    "text": "I can see you, Kaylee!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1972,
    "file": "937c72fb8d5c.mp3"
  },
  {
    "text": "Alpacas hum when they are happy!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2388,
    "file": "5b31e89f274b.mp3"
  },
  {
    "text": "Now the clippers! Snip snip!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2570,
    "file": "840b776639f0.mp3"
  },
  {
    "text": "Done? Tap the pond to show Luna!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3682,
    "file": "7d7a9ac3feda.mp3"
  },
  {
    "text": "Hee hee! A mustache!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1708,
    "file": "2800b512eb70.mp3"
  },
  {
    "text": "I look so silly!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1604,
    "file": "76442d1b8527.mp3"
  },
  {
    "text": "So pretty!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1211,
    "file": "8316576f1c5b.mp3"
  },
  {
    "text": "Brrr! Hat please!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2466,
    "file": "84cf1411aa12.mp3"
  },
  {
    "text": "Brrr! It's chilly up here!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2742,
    "file": "fb1b1408b3a8.mp3"
  },
  {
    "text": "Me next! Me next!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 1879,
    "file": "ee3aeb028b6a.mp3"
  },
  {
    "text": "My turn, dear.",
    "voice": "abuela",
    "sig": "6d0b923627",
    "ms": 1475,
    "file": "e3d00b479ad2.mp3"
  },
  {
    "text": "Paco and Abuela want haircuts too!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4208,
    "file": "98e90d7f2da6.mp3"
  },
  {
    "text": "Hee hee! That tickles!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 1881,
    "file": "a81d5921967b.mp3"
  },
  {
    "text": "Not my tummy!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 1598,
    "file": "27b1c25d80b7.mp3"
  },
  {
    "text": "Ha ha ha!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 1044,
    "file": "74b8c2fac4f1.mp3"
  },
  {
    "text": "Too tickly!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 1015,
    "file": "c25b8a91cacf.mp3"
  },
  {
    "text": "Oh, I am so sleepy...",
    "voice": "abuela",
    "sig": "6d0b923627",
    "ms": 3406,
    "file": "7f8273064990.mp3"
  },
  {
    "text": "Five more minutes...",
    "voice": "abuela",
    "sig": "6d0b923627",
    "ms": 1830,
    "file": "511f46be93ab.mp3"
  },
  {
    "text": "Brrr! Chilly!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 2269,
    "file": "e1b1cf38ad26.mp3"
  },
  {
    "text": "Oh my! Brrr!",
    "voice": "abuela",
    "sig": "6d0b923627",
    "ms": 2684,
    "file": "e59437299f3a.mp3"
  },
  {
    "text": "The wool is yarn now! Tap the cactus!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3640,
    "file": "b702d696db3c.mp3"
  },
  {
    "text": "A tiny bug makes pink color!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3101,
    "file": "f23ea0c8e2bb.mp3"
  },
  {
    "text": "Drag the pink drop to the yarn!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2594,
    "file": "2246b4fbb4f7.mp3"
  },
  {
    "text": "Pink yarn! Pink hats!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2738,
    "file": "f93e3e9f1bf4.mp3"
  },
  {
    "text": "Put a warm hat on each alpaca!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3387,
    "file": "72b19f1e0e00.mp3"
  },
  {
    "text": "Cozy!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1012,
    "file": "cc0acfe156c4.mp3"
  },
  {
    "text": "Yay! Warm ears!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 2064,
    "file": "a0832ffb739a.mp3"
  },
  {
    "text": "Thank you, dear!",
    "voice": "abuela",
    "sig": "6d0b923627",
    "ms": 1160,
    "file": "f02a1a21f0e8.mp3"
  },
  {
    "text": "Click! A picture for my journal!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2385,
    "file": "15431e0b1b84.mp3"
  },
  {
    "text": "Alpacas come in lots of colors!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2582,
    "file": "c199d0f4d576.mp3"
  },
  {
    "text": "Rub the brush on Luna's fleece!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2367,
    "file": "669b45e79699.mp3"
  },
  {
    "text": "Snip the fluffy puffs!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1995,
    "file": "1424a22023b7.mp3"
  },
  {
    "text": "Tap the cactus!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1934,
    "file": "7a19dcae5ffd.mp3"
  },
  {
    "text": "Drag a hat onto an alpaca!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2546,
    "file": "b46f7505e913.mp3"
  },
  {
    "text": "My chick Pluma is scared to fly.",
    "voice": "coco",
    "sig": "794c66c94c",
    "ms": 3317,
    "file": "e4b9ef60bd2c.mp3"
  },
  {
    "text": "Grab Coco and show her how!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2542,
    "file": "3dd09b1e0083.mp3"
  },
  {
    "text": "Fly into the warm air!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1895,
    "file": "8186a59ae473.mp3"
  },
  {
    "text": "Ahh, warm air! Up we go!",
    "voice": "coco",
    "sig": "794c66c94c",
    "ms": 3716,
    "file": "5a9f07718e28.mp3"
  },
  {
    "text": "I need warm air to go up!",
    "voice": "coco",
    "sig": "794c66c94c",
    "ms": 2788,
    "file": "e4da24e55582.mp3"
  },
  {
    "text": "Whoooosh!",
    "voice": "coco",
    "sig": "794c66c94c",
    "ms": 1137,
    "file": "5bf49a2af09c.mp3"
  },
  {
    "text": "Achoo!",
    "voice": "coco",
    "sig": "794c66c94c",
    "ms": 674,
    "file": "cd42bb8f4721.mp3"
  },
  {
    "text": "It's so high!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 1493,
    "file": "7933ed52ec1d.mp3"
  },
  {
    "text": "Come on, Pluma! Fly with me!",
    "voice": "coco",
    "sig": "794c66c94c",
    "ms": 2941,
    "file": "cb48bd84b2a0.mp3"
  },
  {
    "text": "I'll try! Here I come!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 2115,
    "file": "892486cad6c9.mp3"
  },
  {
    "text": "Lead Pluma to the shiny circles!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3555,
    "file": "601e95ffea16.mp3"
  },
  {
    "text": "Wait for me!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 996,
    "file": "d6fc6a56d8f1.mp3"
  },
  {
    "text": "Wheee!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 973,
    "file": "03354a2a9585.mp3"
  },
  {
    "text": "I'm dizzy!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 970,
    "file": "01b17fbbe505.mp3"
  },
  {
    "text": "Ooh, a waterfall!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 2883,
    "file": "a5c52b6186e0.mp3"
  },
  {
    "text": "Hello, friends!",
    "voice": "coco",
    "sig": "794c66c94c",
    "ms": 1130,
    "file": "dfad6ba7fd08.mp3"
  },
  {
    "text": "People are waving!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 1507,
    "file": "c66cbf60b58b.mp3"
  },
  {
    "text": "Smile for the photo!",
    "voice": "coco",
    "sig": "794c66c94c",
    "ms": 1549,
    "file": "6f4b3546250f.mp3"
  },
  {
    "text": "The sun moved! Find the new warm air!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3318,
    "file": "1292939bcd17.mp3"
  },
  {
    "text": "Fly to the very top!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1731,
    "file": "205b38fc63d2.mp3"
  },
  {
    "text": "I can fly by myself!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 2131,
    "file": "bd247b542184.mp3"
  },
  {
    "text": "Now you fly Pluma, Kaylee!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3171,
    "file": "a1c7849b7744.mp3"
  },
  {
    "text": "Fly Pluma into the big swirl!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3447,
    "file": "417db67935b0.mp3"
  },
  {
    "text": "Look at me, Kaylee!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 1498,
    "file": "bf95d8cafcd4.mp3"
  },
  {
    "text": "My Pluma can fly! Gracias, Kaylee!",
    "voice": "coco",
    "sig": "794c66c94c",
    "ms": 3885,
    "file": "d27c4b7b43d2.mp3"
  },
  {
    "text": "Click! A picture for Luna's journal!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2702,
    "file": "73df44cc1cba.mp3"
  },
  {
    "text": "Hi, Dad!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 981,
    "file": "47490d45a1be.mp3"
  },
  {
    "text": "Grab Coco and fly!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2304,
    "file": "c58568c8ff33.mp3"
  },
  {
    "text": "Fly to a shiny circle!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1955,
    "file": "41f93b65aeb3.mp3"
  },
  {
    "text": "Condors hardly flap their wings!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2831,
    "file": "3c27f5abc035.mp3"
  },
  {
    "text": "Condor wings are wider than a grown-up is tall!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3399,
    "file": "b5d32ed6b684.mp3"
  },
  {
    "text": "This canyon is super deep!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2822,
    "file": "3b31b3642841.mp3"
  },
  {
    "text": "The sun warms the air, and warm air rises!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4650,
    "file": "e3110b3cb611.mp3"
  },
  {
    "text": "I can fly!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 1047,
    "file": "40f47095cbee.mp3"
  },
  {
    "text": "Condor sticker! Condors soar on warm air!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 5636,
    "file": "9dc627ad3d0c.mp3"
  },
  {
    "text": "Alpaca sticker! Alpacas have soft, warm fleece!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4722,
    "file": "fbb401e41c19.mp3"
  },
  {
    "text": "Peru is in South America!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2423,
    "file": "a71a5a4d0354.mp3"
  },
  {
    "text": "Peru has a coast, mountains, and rainforest!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3539,
    "file": "80283fcfaafb.mp3"
  },
  {
    "text": "Hola means hello in Spanish!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2812,
    "file": "713ee53c4216.mp3"
  },
  {
    "text": "People in Peru also speak Quechua and Aymara!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4255,
    "file": "f88b7cc7c029.mp3"
  },
  {
    "text": "Peru has penguins on its desert coast!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3329,
    "file": "54ba723e6752.mp3"
  },
  {
    "text": "Alpacas live high in the mountains!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3194,
    "file": "bc8bce10ce46.mp3"
  },
  {
    "text": "The Inca built Machu Picchu long ago!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4148,
    "file": "4db8b2b5b95b.mp3"
  },
  {
    "text": "Peru has thousands of kinds of potatoes!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3089,
    "file": "4bc4431f1b60.mp3"
  },
  {
    "text": "Peru's flag is red, white, red!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3326,
    "file": "c0c037edd733.mp3"
  },
  {
    "text": "Peru's bird is bright orange!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3068,
    "file": "d4f1ec4fc526.mp3"
  },
  {
    "text": "This is Peru! Tap a picture to explore.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3750,
    "file": "e6add4cd764f.mp3"
  }
]
