    "sig": "ed7dbdac3d",
    "ms": 3555,
    "file": "601e95ffea16.mp3"
  },
  {
    "text": "Wait for me!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 996,
    "file": "d6fc6a56d8f1.mp3"
  },
  {
    "text": "Wheee!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 973,
    "file": "03354a2a9585.mp3"
  },
  {
    "text": "I'm dizzy!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 970,
    "file": "01b17fbbe505.mp3"
  },
  {
    "text": "Ooh, a waterfall!",
    "voice": "pluma",
    "sig": "666bb7638e",
    "ms": 2883,
    "file": "a5c52b6186e0.mp3"
  },
  {
    "text": "Hello, friends!",
    "voice": "coco",
    "sig": "794c66c94c",
    "ms": 1130,
    "file": "dfad6ba7fd08.mp3"
  },
  {
    "text": "People are waving!",
