[
  {
    "text": "Peru",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 677,
    "file": "07e04325fe70.mp3"
  },
  {
    "text": "Kaylee, you did it! You won the Peru Explorer trophy!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4751,
    "file": "9ceadef5975f.mp3"
  },
  {
    "text": "Kaylee, Peru Explorer! From Peru.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4574,
    "file": "46b37a8b8b1e.mp3"
  },
  {
    "text": "Hola, Kaylee! I'm Luna!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2048,
    "file": "480495cdd2a4.mp3"
  },
  {
    "text": "Let's fill my explorer journal!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2194,
    "file": "40416dcdfe6e.mp3"
  },
  {
    "text": "Tap a picture to explore Peru!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2834,
    "file": "25e8872981a6.mp3"
  },
  {
    "text": "Another discovery, Kaylee!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2114,
    "file": "bef51fccef7f.mp3"
  },
  {
    "text": "This place opens soon!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1818,
    "file": "7383ac54928f.mp3"
  },
  {
    "text": "Our balloon trip comes soon!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2690,
    "file": "b340c9d6e692.mp3"
  },
  {
    "text": "Hee hee!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 956,
    "file": "739a4d92b706.mp3"
  },
  {
    "text": "I love exploring with you!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1712,
    "file": "e28a2924a025.mp3"
  },
  {
    "text": "My explorer journal!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1811,
    "file": "fe661d7e1416.mp3"
  },
  {
    "text": "My cozy alpaca family!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2294,
    "file": "07818277ebd4.mp3"
  },
  {
    "text": "By the sea, Peru has a sandy desert!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4217,
    "file": "76e44b3818dd.mp3"
  },
  {
    "text": "The Andes mountains are tall and cold!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3883,
    "file": "b5a0a775478a.mp3"
  },
  {
    "text": "Half of Peru is rainforest!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2901,
    "file": "f7e2d8ad8051.mp3"
  },
  {
    "text": "My fleece is so long, I can't see!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2957,
    "file": "c5d1c4a2be37.mp3"
  },
  {
    "text": "Brush Luna's fleece, Kaylee!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3013,
    "file": "dc5c9420a7d9.mp3"
  },
  {
    "text": "Ouch! Prickly!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1389,
    "file": "e3e146a8b10c.mp3"
  },
  {
    "text": "A twig!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 759,
    "file": "1c449a266d70.mp3"
  },
  {
    "text": "Achoo!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 530,
    "file": "ff204fe0637a.mp3"
  },
  {
    "text": "A baby bird!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1180,
    "file": "f776bca89a5b.mp3"
  },
  {
    "text": "Bye-bye, beetle!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 944,
    "file": "5ed174fb2d51.mp3"
  },
  {
    "text": "I can see you, Kaylee!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1972,
    "file": "937c72fb8d5c.mp3"
  },
  {
    "text": "Alpacas hum when they are happy!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2388,
    "file": "5b31e89f274b.mp3"
  },
  {
    "text": "Now the clippers! Snip snip!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2570,
    "file": "840b776639f0.mp3"
  },
  {
    "text": "Done? Tap the pond to show Luna!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3682,
    "file": "7d7a9ac3feda.mp3"
  },
  {
    "text": "Hee hee! A mustache!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1708,
    "file": "2800b512eb70.mp3"
  },
  {
    "text": "I look so silly!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1604,
    "file": "76442d1b8527.mp3"
  },
  {
    "text": "So pretty!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1211,
    "file": "8316576f1c5b.mp3"
  },
  {
    "text": "Brrr! Hat please!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2466,
    "file": "84cf1411aa12.mp3"
  },
  {
    "text": "Brrr! It's chilly up here!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2742,
    "file": "fb1b1408b3a8.mp3"
  },
  {
    "text": "Me next! Me next!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 1879,
    "file": "ee3aeb028b6a.mp3"
  },
  {
    "text": "My turn, dear.",
    "voice": "abuela",
    "sig": "6d0b923627",
    "ms": 1475,
    "file": "e3d00b479ad2.mp3"
  },
  {
    "text": "Paco and Abuela want haircuts too!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4208,
    "file": "98e90d7f2da6.mp3"
  },
  {
    "text": "Hee hee! That tickles!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 1881,
    "file": "a81d5921967b.mp3"
  },
  {
    "text": "Not my tummy!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 1598,
    "file": "27b1c25d80b7.mp3"
  },
  {
    "text": "Ha ha ha!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 1044,
    "file": "74b8c2fac4f1.mp3"
  },
  {
    "text": "Too tickly!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 1015,
    "file": "c25b8a91cacf.mp3"
  },
  {
    "text": "Oh, I am so sleepy...",
    "voice": "abuela",
    "sig": "6d0b923627",
    "ms": 3406,
    "file": "7f8273064990.mp3"
  },
  {
    "text": "Five more minutes...",
    "voice": "abuela",
    "sig": "6d0b923627",
    "ms": 1830,
    "file": "511f46be93ab.mp3"
  },
  {
    "text": "Brrr! Chilly!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 2269,
    "file": "e1b1cf38ad26.mp3"
  },
  {
    "text": "Oh my! Brrr!",
    "voice": "abuela",
    "sig": "6d0b923627",
    "ms": 2684,
    "file": "e59437299f3a.mp3"
  },
  {
    "text": "The wool is yarn now! Tap the cactus!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3640,
    "file": "b702d696db3c.mp3"
  },
  {
    "text": "A tiny bug makes pink color!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3101,
    "file": "f23ea0c8e2bb.mp3"
  },
  {
    "text": "Drag the pink drop to the yarn!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2594,
    "file": "2246b4fbb4f7.mp3"
  },
  {
    "text": "Pink yarn! Pink hats!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2738,
    "file": "f93e3e9f1bf4.mp3"
  },
  {
    "text": "Put a warm hat on each alpaca!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3387,
    "file": "72b19f1e0e00.mp3"
  },
  {
    "text": "Cozy!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 1012,
    "file": "cc0acfe156c4.mp3"
  },
  {
    "text": "Yay! Warm ears!",
    "voice": "paco",
    "sig": "cde399837f",
    "ms": 2064,
    "file": "a0832ffb739a.mp3"
  },
  {
    "text": "Thank you, dear!",
    "voice": "abuela",
    "sig": "6d0b923627",
    "ms": 1160,
    "file": "f02a1a21f0e8.mp3"
  },
  {
    "text": "Click! A picture for my journal!",
    "voice": "luna",
    "sig": "8c4095048f",
    "ms": 2385,
    "file": "15431e0b1b84.mp3"
  },
  {
    "text": "Alpacas come in lots of colors!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2582,
    "file": "c199d0f4d576.mp3"
  },
  {
    "text": "Rub the brush on Luna's fleece!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2367,
    "file": "669b45e79699.mp3"
  },
  {
    "text": "Snip the fluffy puffs!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1995,
    "file": "1424a22023b7.mp3"
  },
  {
    "text": "Tap the cactus!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1934,
    "file": "7a19dcae5ffd.mp3"
  },
  {
    "text": "Drag a hat onto an alpaca!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2546,
    "file": "b46f7505e913.mp3"
  },
  {
    "text": "Oh no! Our grass steps fell down!",
    "voice": "tika",
    "sig": "241b278019",
    "ms": 3373,
    "file": "4d1a1131f7b0.mp3"
  },
  {
    "text": "Fit the stones back in, Kaylee!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2550,
    "file": "b83727bb6371.mp3"
  },
  {
    "text": "Clonk!",
    "voice": "tika",
    "sig": "241b278019",
    "ms": 610,
    "file": "4af340bef923.mp3"
  },
  {
    "text": "It fits!",
    "voice": "tika",
    "sig": "241b278019",
    "ms": 859,
    "file": "1c57c31493e2.mp3"
  },
  {
    "text": "Like a puzzle!",
    "voice": "tika",
    "sig": "241b278019",
    "ms": 1807,
    "file": "30b79e8cd52e.mp3"
  },
  {
    "text": "Perfect!",
    "voice": "tika",
    "sig": "241b278019",
    "ms": 738,
    "file": "506581607c96.mp3"
  },
  {
    "text": "Look for the glowing spot!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1826,
    "file": "34d7fb849aba.mp3"
  },
  {
    "text": "Our terrace is back!",
    "voice": "tika",
    "sig": "241b278019",
    "ms": 1673,
    "file": "51eca0e882fe.mp3"
  },
  {
    "text": "Yum! Fresh grass!",
    "voice": "tika",
    "sig": "241b278019",
    "ms": 2466,
    "file": "b55291025a24.mp3"
  },
  {
    "text": "Another step!",
    "voice": "tika",
    "sig": "241b278019",
    "ms": 1173,
    "file": "115920f359d6.mp3"
  },
  {
    "text": "We made it to the top!",
    "voice": "tika",
    "sig": "241b278019",
    "ms": 1814,
    "file": "6cb69cc44782.mp3"
  },
  {
    "text": "What should we grow here?",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1789,
    "file": "15b6e9e334d4.mp3"
  },
  {
    "text": "Potatoes!",
    "voice": "tika",
    "sig": "241b278019",
    "ms": 1001,
    "file": "f77b07034567.mp3"
  },
  {
    "text": "Corn!",
    "voice": "tika",
    "sig": "241b278019",
    "ms": 608,
    "file": "d28df3a0eb12.mp3"
  },
  {
    "text": "Flowers!",
    "voice": "tika",
    "sig": "241b278019",
    "ms": 815,
    "file": "46f92a316a3e.mp3"
  },
  {
    "text": "Build the next step!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1734,
    "file": "160d50233e3d.mp3"
  },
  {
    "text": "Come on up, friends!",
    "voice": "tika",
    "sig": "241b278019",
    "ms": 1754,
    "file": "c6c22c510074.mp3"
  },
  {
    "text": "This stone has so many corners!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2622,
    "file": "24101278cc99.mp3"
  },
  {
    "text": "So many clouds! I can't see!",
    "voice": "tika",
    "sig": "241b278019",
    "ms": 2554,
    "file": "8c89d8cecd41.mp3"
  },
  {
    "text": "The last wall! Up in the clouds!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3608,
    "file": "436d66d412f3.mp3"
  },
  {
    "text": "Kaylee, look! Machu Picchu!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2712,
    "file": "883fb9d49e0c.mp3"
  },
  {
    "text": "Tap the camera for Luna's journal!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3530,
    "file": "cd9334e228a1.mp3"
  },
  {
    "text": "Me too!",
    "voice": "tika",
    "sig": "241b278019",
    "ms": 1327,
    "file": "ec0f99e04b22.mp3"
  },
  {
    "text": "Cheese!",
    "voice": "tika",
    "sig": "241b278019",
    "ms": 659,
    "file": "1086c32ad7b6.mp3"
  },
  {
    "text": "My best side!",
    "voice": "tika",
    "sig": "241b278019",
    "ms": 1946,
    "file": "7bc3d345b4fb.mp3"
  },
  {
    "text": "Say llama!",
    "voice": "tika",
    "sig": "241b278019",
    "ms": 1453,
    "file": "27078e507a55.mp3"
  },
  {
    "text": "One more!",
    "voice": "tika",
    "sig": "241b278019",
    "ms": 1131,
    "file": "fac1fef7f882.mp3"
  },
  {
    "text": "A picture for Luna's journal!",
    "voice": "tika",
    "sig": "241b278019",
    "ms": 2255,
    "file": "d6cfecf428db.mp3"
  },
  {
    "text": "Dance, dance, dance!",
    "voice": "tika",
    "sig": "241b278019",
    "ms": 1970,
    "file": "db4fc0ea80ee.mp3"
  },
  {
    "text": "Who, me?",
    "voice": "tika",
    "sig": "241b278019",
    "ms": 1319,
    "file": "e341f5ca8841.mp3"
  },
  {
    "text": "Hey! A stage!",
    "voice": "tika",
    "sig": "241b278019",
    "ms": 1814,
    "file": "704a90695266.mp3"
  },
  {
    "text": "Hee hee!",
    "voice": "tika",
    "sig": "241b278019",
    "ms": 921,
    "file": "58ddeb0c6894.mp3"
  },
  {
    "text": "Hola!",
    "voice": "tika",
    "sig": "241b278019",
    "ms": 486,
    "file": "49de4fca7675.mp3"
  },
  {
    "text": "Munch munch.",
    "voice": "tika",
    "sig": "241b278019",
    "ms": 1812,
    "file": "8b023ad86fbc.mp3"
  },
  {
    "text": "A shy spectacled bear!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2667,
    "file": "68b4ecbc0b77.mp3"
  },
  {
    "text": "Peru has thousands of kinds of potatoes!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3089,
    "file": "4bc4431f1b60.mp3"
  },
  {
    "text": "The stones fit together like a puzzle!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2618,
    "file": "1d44480b6656.mp3"
  },
  {
    "text": "Llamas can carry things up the mountain!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2906,
    "file": "c3be66c23c88.mp3"
  },
  {
    "text": "Drag a stone into a hole!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2121,
    "file": "08b77025449e.mp3"
  },
  {
    "text": "Tap a seed bag to plant it!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2486,
    "file": "245628a7848b.mp3"
  },
  {
    "text": "Tap the camera!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1171,
    "file": "138078ce77a9.mp3"
  },
  {
    "text": "Me at Machu Picchu!",
    "voice": "tika",
    "sig": "241b278019",
    "ms": 1684,
    "file": "a6ac22a6b87c.mp3"
  },
  {
    "text": "Llama sticker! Llamas can carry things up mountains!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3960,
    "file": "d73b6cb8fd77.mp3"
  },
  {
    "text": "Alpaca sticker! Alpacas have soft, warm fleece!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4722,
    "file": "fbb401e41c19.mp3"
  },
  {
    "text": "Peru is in South America!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2423,
    "file": "a71a5a4d0354.mp3"
  },
  {
    "text": "Peru has a coast, mountains, and rainforest!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3539,
    "file": "80283fcfaafb.mp3"
  },
  {
    "text": "Hola means hello in Spanish!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2812,
    "file": "713ee53c4216.mp3"
  },
  {
    "text": "People in Peru also speak Quechua and Aymara!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4255,
    "file": "f88b7cc7c029.mp3"
  },
  {
    "text": "Peru has penguins on its desert coast!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3329,
    "file": "54ba723e6752.mp3"
  },
  {
    "text": "Alpacas live high in the mountains!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3194,
    "file": "bc8bce10ce46.mp3"
  },
  {
    "text": "The Inca built Machu Picchu long ago!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4148,
    "file": "4db8b2b5b95b.mp3"
  },
  {
    "text": "Peru's flag is red, white, red!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3326,
    "file": "c0c037edd733.mp3"
  },
  {
    "text": "Peru's bird is bright orange!",
    "voice": "sparkle",
