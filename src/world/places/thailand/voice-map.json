[
  {
    "text": "Kaylee, you did it! You won the Thailand Explorer trophy!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 5340,
    "file": "18ba68fd9d0a.mp3"
  },
  {
    "text": "Kaylee, Thailand Explorer! From Thailand.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3678,
    "file": "e6bb5c28b2b2.mp3"
  },
  {
    "text": "Sawasdee, Kaylee!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1538,
    "file": "7e24935b022b.mp3"
  },
  {
    "text": "Thailand is the land of elephants!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2532,
    "file": "4b957786447e.mp3"
  },
  {
    "text": "Tap the elephant cafe!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2163,
    "file": "c761ce1d615c.mp3"
  },
  {
    "text": "What a yummy trip, Kaylee!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2244,
    "file": "8bd2af9d17d9.mp3"
  },
  {
    "text": "More of Thailand comes soon!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2413,
    "file": "a129bc57a2f5.mp3"
  },
  {
    "text": "Our Thailand party comes soon!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3048,
    "file": "938d5b467f38.mp3"
  },
  {
    "text": "Hee hee!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 707,
    "file": "dae56d35cab9.mp3"
  },
  {
    "text": "I love Thailand!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2087,
    "file": "2a2ff3c990ce.mp3"
  },
  {
    "text": "This is the Andaman Sea! It is warm and blue!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3986,
    "file": "e424263e7caa.mp3"
  },
  {
    "text": "Up north, there are tall green mountains!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3488,
    "file": "7a344330f21c.mp3"
  },
  {
    "text": "Bangkok is the big busy city!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2667,
    "file": "72d42d312bec.mp3"
  },
  {
    "text": "Elephant sticker! Elephants eat all day long!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3197,
    "file": "4a7bf6706acc.mp3"
  },
  {
    "text": "This is Thailand! Tap a picture to explore.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3864,
    "file": "9cbdc71bb4e9.mp3"
  },
  {
    "text": "In Thailand, we say Sawasdee to say hello!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4335,
    "file": "3c01fbd52427.mp3"
  },
  {
    "text": "The elephant is Thailand's special animal!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3478,
    "file": "160455d31444.mp3"
  },
  {
    "text": "In Thai, chang means elephant!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3463,
    "file": "a51769ba6c32.mp3"
  },
  {
    "text": "Thailand's flag is red, white and blue!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3593,
    "file": "b4ba7cc39d1a.mp3"
  },
  {
    "text": "Welcome to Baan Chang!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2051,
    "file": "622558a18618.mp3"
  },
  {
    "text": "Coffee for Daddy first!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1817,
    "file": "52ff32b026a3.mp3"
  },
  {
    "text": "Drop in the ice!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2285,
    "file": "2d23482501ee.mp3"
  },
  {
    "text": "Tip the coffee in!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1898,
    "file": "0e1780e92a40.mp3"
  },
  {
    "text": "Now pour the milk!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1466,
    "file": "9f9e7d23b916.mp3"
  },
  {
    "text": "Pop in a straw!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1518,
    "file": "ae7820f693f4.mp3"
  },
  {
    "text": "Bring Daddy his coffee!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1802,
    "file": "7b48a1ccfa37.mp3"
  },
  {
    "text": "Daddy loves it!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1799,
    "file": "df023189ad88.mp3"
  },
  {
    "text": "Now chocolate milk for you!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1891,
    "file": "6ab10d0b4be4.mp3"
  },
  {
    "text": "Squeeze in the chocolate!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2193,
    "file": "2fabe94b3d6d.mp3"
  },
  {
    "text": "Stir, stir, stir!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2235,
    "file": "90f8bfd01e4d.mp3"
  },
  {
    "text": "Pick a straw!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1467,
    "file": "de49850b5b9f.mp3"
  },
  {
    "text": "Whipped cream on top?",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1488,
    "file": "82d0e38eb8e4.mp3"
  },
  {
    "text": "Let's go see the elephants!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2149,
    "file": "03d2ffd731b3.mp3"
  },
  {
    "text": "Whoa! Too full!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2245,
    "file": "bb7a1abe8399.mp3"
  },
  {
    "text": "Hold a banana up to a trunk!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2374,
    "file": "b9f77386a77f.mp3"
  },
  {
    "text": "Hold the food near a trunk!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2402,
    "file": "2a634a66413d.mp3"
  },
  {
    "text": "Look! Each elephant wants a snack!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2618,
    "file": "4e7059b86989.mp3"
  },
  {
    "text": "Look in the bubble!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1902,
    "file": "df0a530c25df.mp3"
  },
  {
    "text": "Hee hee! Not that one!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2423,
    "file": "de48f7b8191e.mp3"
  },
  {
    "text": "A big watermelon! Give it to a grown-up elephant!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4459,
    "file": "e93ab242a163.mp3"
  },
  {
    "text": "Too big for the baby!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2450,
    "file": "dc3815364b0e.mp3"
  },
  {
    "text": "Now the baby can eat it!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2576,
    "file": "3115e76d9301.mp3"
  },
  {
    "text": "Hey! That is your chocolate milk!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3499,
    "file": "54f14d837576.mp3"
  },
  {
    "text": "The elephants are full! Thank you!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2955,
    "file": "abdc9222911b.mp3"
  },
  {
    "text": "Yum! Great job, Kaylee!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2328,
    "file": "29eceff4b040.mp3"
  },
  {
    "text": "Crunch, crunch!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1866,
    "file": "5cb50c76f6a0.mp3"
  },
  {
    "text": "Mmm, yummy!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2277,
    "file": "d8fb3255e223.mp3"
  },
  {
    "text": "One!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 510,
    "file": "87ed107b16cf.mp3"
  },
  {
    "text": "Two!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 612,
    "file": "e53b779eaf65.mp3"
  },
  {
    "text": "Three!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 746,
    "file": "b98340c9d88a.mp3"
  }
]
