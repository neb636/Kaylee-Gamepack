    "sig": "ed7dbdac3d",
    "ms": 3321,
    "file": "e494dab1b12b.mp3"
  },
  {
    "text": "Pai means let's go!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2018,
    "file": "ed769bec3b39.mp3"
  },
  {
    "text": "The sea nibbled a notch in the rock!",
