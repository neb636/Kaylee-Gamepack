    "sig": "ed7dbdac3d",
    "ms": 2827,
    "file": "7a8f32e6ea0f.mp3"
  },
  {
    "text": "Tap a pose!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1041,
    "file": "cae6d63a47cb.mp3"
  },
  {
    "text": "Drive back to the pier!",
