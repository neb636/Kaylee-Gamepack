    "sig": "ed7dbdac3d",
    "ms": 3464,
    "file": "6c9e80112b8f.mp3"
  },
  {
    "text": "A mudskipper walks on mud!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3367,
    "file": "082124ef6225.mp3"
  },
  {
    "text": "A monitor lizard swims like a croc!",
