[
  {
    "text": "Kaylee, you did it! You won the Thailand Explorer trophy!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 5340,
    "file": "18ba68fd9d0a.mp3"
  },
  {
    "text": "Kaylee, Thailand Explorer! From Thailand.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3678,
    "file": "e6bb5c28b2b2.mp3"
  },
  {
    "text": "This is Thailand! Tap a picture to explore.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3864,
    "file": "9cbdc71bb4e9.mp3"
  },
  {
    "text": "In Thailand, we say Sawasdee to say hello!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4335,
    "file": "3c01fbd52427.mp3"
  },
  {
    "text": "The elephant is Thailand's special animal!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3478,
    "file": "160455d31444.mp3"
  },
  {
    "text": "In Thai, chang means elephant!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3463,
    "file": "a51769ba6c32.mp3"
  },
  {
    "text": "Thailand's flag is red, white and blue!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3593,
    "file": "b4ba7cc39d1a.mp3"
  },
  {
    "text": "Thai cars drive on the left!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2456,
    "file": "8ce90a849b18.mp3"
  },
  {
    "text": "We're at Agong's house in Thailand, Kaylee!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3551,
    "file": "809c4470b77d.mp3"
  },
  {
    "text": "Tap the door to go inside!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2450,
    "file": "d1a831ff8ac6.mp3"
  },
  {
    "text": "Tap your family to say hello!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2242,
    "file": "88573e942ffd.mp3"
  },
  {
    "text": "This is your room! Try the mattress!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2917,
    "file": "a3f49991cdbd.mp3"
  },
  {
    "text": "I don't need to go to the bathroom!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2026,
    "file": "eb6e59742e9a.mp3"
  },
  {
    "text": "Tap the stairs to go up to your room!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2947,
    "file": "64b49dc4a710.mp3"
  },
  {
    "text": "Bounce on the mattress, Kaylee!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2249,
    "file": "2688da9fafc1.mp3"
  },
  {
    "text": "A spirit house! Thai families give it flowers and a drink.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4882,
    "file": "e6afc4bf0b7d.mp3"
  },
  {
    "text": "Put your hands together and bow. In Thailand, that is a wai!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 5003,
    "file": "6957332598c0.mp3"
  },
  {
    "text": "A tuk-tuk! It goes tuk tuk tuk!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3546,
    "file": "694cd017d73f.mp3"
  },
  {
    "text": "Thai families eat rice every day!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2858,
    "file": "ab5ad83fe287.mp3"
  },
  {
    "text": "The lucky cat waves for good luck!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2727,
    "file": "fc105715c91c.mp3"
  },
  {
    "text": "A gecko! It sings took-geh, took-geh!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3819,
    "file": "b6c3b009349c.mp3"
  },
  {
    "text": "Lots of people in Thailand ride motorbikes!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4500,
    "file": "6aec27896584.mp3"
  },
  {
    "text": "Sawasdee krub, Kaylee! Welcome home!",
    "voice": "agong",
    "sig": "0f90e139f5",
    "ms": 4309,
    "file": "203262be0267.mp3"
  },
  {
    "text": "Come, sit with Agong.",
    "voice": "agong",
    "sig": "0f90e139f5",
    "ms": 2269,
    "file": "0bea3df853d9.mp3"
  },
  {
    "text": "Ho ho! My little unicorn!",
    "voice": "agong",
    "sig": "0f90e139f5",
    "ms": 2662,
    "file": "b117b3dc1ac8.mp3"
  },
  {
    "text": "Hi sweetie! This is our room!",
    "voice": "ji",
    "sig": "ba2e98c34e",
    "ms": 2413,
    "file": "1b154a36c869.mp3"
  },
  {
    "text": "Bounce on the mattress!",
    "voice": "ji",
    "sig": "ba2e98c34e",
    "ms": 1867,
    "file": "49cbf7bbbc61.mp3"
  },
  {
    "text": "I love you, Kaylee!",
    "voice": "ji",
    "sig": "ba2e98c34e",
    "ms": 1142,
    "file": "11f448002934.mp3"
  },
  {
    "text": "Hi Kaylee! Welcome to Agong's house!",
    "voice": "nick",
    "sig": "a2881bb105",
    "ms": 2507,
    "file": "34b1b993b42c.mp3"
  },
  {
    "text": "High five!",
    "voice": "nick",
    "sig": "a2881bb105",
    "ms": 883,
    "file": "02a28b88283b.mp3"
  },
  {
    "text": "Let's go inside!",
    "voice": "nick",
    "sig": "a2881bb105",
    "ms": 1208,
    "file": "a6a92009bbdf.mp3"
  },
  {
    "text": "Sawasdee ka, Kaylee! Are you hungry?",
    "voice": "jum",
    "sig": "4e8ef39b9e",
    "ms": 3749,
    "file": "4a342797426b.mp3"
  },
  {
    "text": "The rice is almost ready!",
    "voice": "jum",
    "sig": "4e8ef39b9e",
    "ms": 2429,
    "file": "9034df1eb925.mp3"
  },
  {
    "text": "So big now, Kaylee!",
    "voice": "jum",
    "sig": "4e8ef39b9e",
    "ms": 2402,
    "file": "1bcdb0658ab6.mp3"
  },
  {
    "text": "Sawasdee ka, Kaylee! Look at Agong's treasures!",
    "voice": "joy",
    "sig": "c3cd84e045",
    "ms": 4396,
    "file": "1b50133000d4.mp3"
  },
  {
    "text": "The lucky cat says hi!",
    "voice": "joy",
    "sig": "c3cd84e045",
    "ms": 1923,
    "file": "14aaa3b714f7.mp3"
  },
  {
    "text": "Hee hee! Hi again!",
    "voice": "joy",
    "sig": "c3cd84e045",
    "ms": 1834,
    "file": "b556bf1864df.mp3"
  },
  {
    "text": "Sawasdee krub, Kaylee!",
    "voice": "bird",
    "sig": "7d72cb4f5c",
    "ms": 2496,
    "file": "56b3655214b2.mp3"
  },
  {
    "text": "Want to sit on my motorbike?",
    "voice": "bird",
    "sig": "7d72cb4f5c",
    "ms": 1952,
    "file": "459402cfb8e0.mp3"
  },
  {
    "text": "Beep beep!",
    "voice": "bird",
    "sig": "7d72cb4f5c",
    "ms": 1490,
    "file": "9bd09d032869.mp3"
  },
  {
    "text": "Mm-hmm. Hi Kaylee.",
    "voice": "gan",
    "sig": "157be5e474",
    "ms": 2173,
    "file": "e9346ca089a2.mp3"
  },
  {
    "text": "One sec, I'm winning!",
    "voice": "gan",
    "sig": "157be5e474",
    "ms": 1967,
    "file": "1967f47b0595.mp3"
  },
  {
    "text": "Uh-huh...",
    "voice": "gan",
    "sig": "157be5e474",
    "ms": 2104,
    "file": "d17c3f654ed5.mp3"
  },
  {
    "text": "Oh. Hi, Kaylee.",
    "voice": "ken",
    "sig": "8506fed695",
    "ms": 2691,
    "file": "11f62f40b159.mp3"
  },
  {
    "text": "Look, a funny video!",
    "voice": "ken",
    "sig": "8506fed695",
    "ms": 1836,
    "file": "6ed6d857043b.mp3"
  },
  {
    "text": "Mm-hmm...",
    "voice": "ken",
    "sig": "8506fed695",
    "ms": 591,
    "file": "fae7c2ad6f33.mp3"
  },
  {
    "text": "Hi Kaylee... one second.",
    "voice": "bb",
    "sig": "16e7dc84f7",
    "ms": 2072,
    "file": "f5266fcb6462.mp3"
  },
  {
    "text": "So cute, Kaylee.",
    "voice": "bb",
    "sig": "16e7dc84f7",
    "ms": 2178,
    "file": "16ae009f5328.mp3"
  },
  {
    "text": "Uh-huh!",
    "voice": "bb",
    "sig": "16e7dc84f7",
    "ms": 526,
    "file": "0c958ffa116a.mp3"
  },
  {
    "text": "Sawasdee ka, Kaylee!",
    "voice": "ja",
    "sig": "4d02c3160a",
    "ms": 2354,
    "file": "3632ad14cc35.mp3"
  },
  {
    "text": "Big smile for the photo!",
    "voice": "ja",
    "sig": "4d02c3160a",
    "ms": 1912,
    "file": "6cc5b01f26be.mp3"
  },
  {
    "text": "Sawasdee ka, Kaylee!",
    "voice": "sri",
    "sig": "db1e0738fa",
    "ms": 3328,
    "file": "b3a927a9c7f0.mp3"
  },
  {
    "text": "Say cheese!",
    "voice": "sri",
    "sig": "db1e0738fa",
    "ms": 1194,
    "file": "f2933af8b0e6.mp3"
  },
  {
    "text": "Kaylee! Sawasdee krub!",
    "voice": "putto",
    "sig": "c95377be59",
    "ms": 2500,
    "file": "7a0b700eeca8.mp3"
  },
  {
    "text": "Let's play!",
    "voice": "putto",
    "sig": "c95377be59",
    "ms": 1066,
    "file": "d5b13c9e3bda.mp3"
  },
  {
    "text": "Hi Kaylee! Hee hee!",
    "voice": "putter",
    "sig": "6f3c0affb3",
    "ms": 1963,
    "file": "03c5548ddde8.mp3"
  },
  {
    "text": "Peep peep!",
    "voice": "putter",
    "sig": "6f3c0affb3",
    "ms": 754,
    "file": "9a8bb7438f72.mp3"
  },
  {
    "text": "Kaylee, are you ready to go on a trip?",
    "voice": "ji",
    "sig": "ba2e98c34e",
    "ms": 2666,
    "file": "2be023f0bc32.mp3"
  },
  {
    "text": "OK! Tell me when!",
    "voice": "ji",
    "sig": "ba2e98c34e",
    "ms": 1531,
    "file": "a0bc3ee70699.mp3"
  },
  {
    "text": "Tap your things to pack them, Kaylee!",
    "voice": "ji",
    "sig": "ba2e98c34e",
    "ms": 2357,
    "file": "af0f79523056.mp3"
  },
  {
    "text": "All packed? Tap the suitcase!",
    "voice": "ji",
    "sig": "ba2e98c34e",
    "ms": 2547,
    "file": "506704e23e83.mp3"
  },
  {
    "text": "It's hot and sunny at the sea!",
    "voice": "ji",
    "sig": "ba2e98c34e",
    "ms": 2704,
    "file": "d142d338d0c9.mp3"
  },
  {
    "text": "Pack some more!",
    "voice": "ji",
    "sig": "ba2e98c34e",
    "ms": 1256,
    "file": "b88a7fea9462.mp3"
  },
  {
    "text": "It's too full! Sit on it!",
    "voice": "ji",
    "sig": "ba2e98c34e",
    "ms": 2733,
    "file": "dd28e83b946c.mp3"
  },
  {
    "text": "Five more minutes...",
    "voice": "gan",
    "sig": "157be5e474",
    "ms": 1811,
    "file": "ec38cf1632f5.mp3"
  },
  {
    "text": "Yawn... so sleepy!",
    "voice": "ji",
    "sig": "ba2e98c34e",
    "ms": 2668,
    "file": "d77090192011.mp3"
  },
  {
    "text": "The fan blew it open!",
    "voice": "ji",
    "sig": "ba2e98c34e",
    "ms": 1512,
    "file": "8ce61ba406c3.mp3"
  },
  {
    "text": "Mommy always packs sunscreen!",
    "voice": "ji",
    "sig": "ba2e98c34e",
    "ms": 2118,
    "file": "8a41426e4c27.mp3"
  },
  {
    "text": "Here's Mommy's spare sun hat!",
    "voice": "ji",
    "sig": "ba2e98c34e",
    "ms": 2153,
    "file": "7891124e9389.mp3"
  },
  {
    "text": "Bring Agong a photo of the Nail Island!",
    "voice": "agong",
    "sig": "0f90e139f5",
    "ms": 3114,
    "file": "1a96dd3eabb1.mp3"
  },
  {
    "text": "Snacks for the trip!",
    "voice": "jum",
    "sig": "4e8ef39b9e",
    "ms": 1462,
    "file": "86573ca28524.mp3"
  },
  {
    "text": "Bye...",
    "voice": "gan",
    "sig": "157be5e474",
    "ms": 901,
    "file": "f48de707dbc9.mp3"
  },
  {
    "text": "Bye...",
    "voice": "ken",
    "sig": "8506fed695",
    "ms": 1102,
    "file": "1c489abcb47e.mp3"
  },
  {
    "text": "Bye...",
    "voice": "bb",
    "sig": "16e7dc84f7",
    "ms": 1940,
    "file": "494caed4e28f.mp3"
  },
  {
    "text": "Aunty Sri is here! Hop in!",
    "voice": "nick",
    "sig": "a2881bb105",
    "ms": 2500,
    "file": "63fdae7c5eca.mp3"
  },
  {
    "text": "Beep beep! To the airport!",
    "voice": "sri",
    "sig": "db1e0738fa",
    "ms": 2057,
    "file": "caa5b260da47.mp3"
  },
  {
    "text": "Put your suitcase on the belt!",
    "voice": "nick",
    "sig": "a2881bb105",
    "ms": 2348,
    "file": "b90a0a7a1385.mp3"
  },
  {
    "text": "Ha ha! What a suitcase!",
    "voice": "officer",
    "sig": "f7a660f94d",
    "ms": 2394,
    "file": "8dd6f02952da.mp3"
  },
  {
    "text": "A sleeping fox?!",
    "voice": "officer",
    "sig": "f7a660f94d",
    "ms": 1494,
    "file": "e8a7bfd9fc6f.mp3"
  },
  {
    "text": "A fan? Ha ha!",
    "voice": "officer",
    "sig": "f7a660f94d",
    "ms": 1731,
    "file": "219ba1f45df3.mp3"
  },
  {
    "text": "Our plane! Tap the door!",
    "voice": "nick",
    "sig": "a2881bb105",
    "ms": 1959,
    "file": "9ab7975bce30.mp3"
  },
  {
    "text": "Seatbelt on, Kaylee!",
    "voice": "ji",
    "sig": "ba2e98c34e",
    "ms": 1951,
    "file": "b7597fc46eab.mp3"
  },
  {
    "text": "Whee! Up we go!",
    "voice": "ji",
    "sig": "ba2e98c34e",
    "ms": 1894,
    "file": "7bd971bed27c.mp3"
  },
  {
    "text": "Tray down, then press the button!",
    "voice": "ji",
    "sig": "ba2e98c34e",
    "ms": 2450,
    "file": "003e67672466.mp3"
  },
  {
    "text": "Snacks for Kaylee!",
    "voice": "attendant",
    "sig": "bd7b5640cb",
    "ms": 1218,
    "file": "ed741d50cfc9.mp3"
  },
  {
    "text": "More snacks?!",
    "voice": "attendant",
    "sig": "bd7b5640cb",
    "ms": 1214,
    "file": "3ba42ebedb04.mp3"
  },
  {
    "text": "Want some of mine?",
    "voice": "ji",
    "sig": "ba2e98c34e",
    "ms": 1226,
    "file": "cff3259005e4.mp3"
  },
  {
    "text": "Night night!",
    "voice": "ji",
    "sig": "ba2e98c34e",
    "ms": 935,
    "file": "fa383ba199c9.mp3"
  },
  {
    "text": "Huh? Are we there yet?",
    "voice": "nick",
    "sig": "a2881bb105",
    "ms": 2146,
    "file": "5ae3aefdf433.mp3"
  },
  {
    "text": "Seatbelts on! We are landing!",
    "voice": "ji",
    "sig": "ba2e98c34e",
    "ms": 2309,
    "file": "3e996a7803ee.mp3"
  },
  {
    "text": "Yay! We're in Krabi!",
    "voice": "nick",
    "sig": "a2881bb105",
    "ms": 2405,
    "file": "db00fcd87dd9.mp3"
  },
  {
    "text": "Thailand looks like an elephant's head!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2143,
    "file": "95486a8ac8c5.mp3"
  },
  {
    "text": "Tap your suitcase!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1912,
    "file": "b1b681770904.mp3"
  },
  {
    "text": "Tap the plane's door!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1795,
    "file": "8d178f9ee4cc.mp3"
  },
  {
    "text": "Tap the tray!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1642,
    "file": "001d4a947da6.mp3"
  },
  {
    "text": "Our longtail boat! Tie on ribbons for good luck!",
    "voice": "nick",
    "sig": "a2881bb105",
    "ms": 3504,
    "file": "3643c127f6b6.mp3"
  },
  {
    "text": "Pai!",
    "voice": "nick",
    "sig": "a2881bb105",
    "ms": 611,
    "file": "b541d1942c09.mp3"
  },
  {
    "text": "Where to, Captain Kaylee?",
    "voice": "nick",
    "sig": "a2881bb105",
    "ms": 2533,
    "file": "f6ff4cd2f897.mp3"
  },
  {
    "text": "My horn!",
    "voice": "nick",
    "sig": "a2881bb105",
    "ms": 950,
    "file": "317afeea1a4c.mp3"
  },
  {
    "text": "Hey! My mango!",
    "voice": "nick",
    "sig": "a2881bb105",
    "ms": 1854,
    "file": "50bbfcb07b15.mp3"
  },
  {
    "text": "Hey! My banana!",
    "voice": "nick",
    "sig": "a2881bb105",
    "ms": 2170,
    "file": "c21f0f2da565.mp3"
  },
  {
    "text": "My sunglasses!",
    "voice": "nick",
    "sig": "a2881bb105",
    "ms": 1532,
    "file": "21d363b10415.mp3"
  },
  {
    "text": "Everybody, pose!",
    "voice": "nick",
    "sig": "a2881bb105",
    "ms": 1958,
    "file": "7d345295367a.mp3"
  },
  {
    "text": "One, two, three, cheese!",
    "voice": "nick",
    "sig": "a2881bb105",
    "ms": 2579,
    "file": "9193f5bf24ac.mp3"
  },
  {
    "text": "Back in the boat, Kaylee!",
    "voice": "nick",
    "sig": "a2881bb105",
    "ms": 2529,
    "file": "a454223488cc.mp3"
  },
  {
    "text": "Whoa!",
    "voice": "ji",
    "sig": "ba2e98c34e",
    "ms": 700,
    "file": "f69c5a84bf71.mp3"
  },
  {
    "text": "My hat!",
    "voice": "ji",
    "sig": "ba2e98c34e",
    "ms": 1170,
    "file": "018f613f9d6c.mp3"
  },
  {
    "text": "So dizzy!",
    "voice": "ji",
    "sig": "ba2e98c34e",
    "ms": 1500,
    "file": "c39ddfb81895.mp3"
  },
  {
    "text": "A coconut! Got it!",
    "voice": "ji",
    "sig": "ba2e98c34e",
    "ms": 1787,
    "file": "aa3cd3f7a59c.mp3"
  },
  {
    "text": "Look! The sky is turning pink!",
    "voice": "ji",
    "sig": "ba2e98c34e",
    "ms": 2622,
    "file": "9bf279460f31.mp3"
  },
  {
    "text": "Goal!",
    "voice": "kids",
    "sig": "2c9a630e41",
    "ms": 804,
    "file": "de32939dd8b5.mp3"
  },
  {
    "text": "Khob khun ka, Kaylee!",
    "voice": "kids",
    "sig": "2c9a630e41",
    "ms": 2020,
    "file": "040dad871beb.mp3"
  },
  {
    "text": "The ball, Kaylee!",
    "voice": "kids",
    "sig": "2c9a630e41",
    "ms": 3436,
    "file": "17423de094b2.mp3"
  },
  {
    "text": "Tap a ribbon to tie it on!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1859,
    "file": "bed340c1cd51.mp3"
  },
  {
    "text": "Now the flowers!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1953,
    "file": "bf3faf0a7a20.mp3"
  },
  {
    "text": "Put your finger on the water to drive!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3425,
    "file": "34a6f417f88a.mp3"
  },
  {
    "text": "Drive to a golden light!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2021,
    "file": "16d7d8f600d8.mp3"
  },
  {
    "text": "Push the ball back with the boat!",
