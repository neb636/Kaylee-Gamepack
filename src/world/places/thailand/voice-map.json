    "sig": "157be5e474",
    "ms": 1933,
    "file": "a80935f5a6b7.mp3"
  },
  {
    "text": "Whoa!",
    "voice": "ken",
    "sig": "8506fed695",
    "ms": 560,
    "file": "ed6531e19303.mp3"
  },
  {
    "text": "So cool, Kaylee!",
    "voice": "bb",
    "sig": "16e7dc84f7",
    "ms": 1547,
    "file": "5352244d05cc.mp3"
  },
