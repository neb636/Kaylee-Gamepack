[
  {
    "text": "Italy",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 554,
    "file": "20e6d6afe5a0.mp3"
  },
  {
    "text": "Kaylee, you did it! You won the Italy Explorer trophy!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4330,
    "file": "bd2d1b8f843a.mp3"
  },
  {
    "text": "Kaylee, Italy Explorer! From Italy.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3292,
    "file": "5562e3331434.mp3"
  },
  {
    "text": "Ciao, Kaylee! I'm Lupa!",
    "voice": "lupa",
    "sig": "1200e8d792",
    "ms": 2500,
    "file": "9c406b832cc3.mp3"
  },
  {
    "text": "Help me get ready to sing at the opera?",
    "voice": "lupa",
    "sig": "1200e8d792",
    "ms": 2442,
    "file": "a9423d7db7af.mp3"
  },
  {
    "text": "Tap the glowing pizza!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1955,
    "file": "1d599b1333af.mp3"
  },
  {
    "text": "Where should we go next, Kaylee?",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2599,
    "file": "213d913bc9ff.mp3"
  },
  {
    "text": "This spot opens soon!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1943,
    "file": "2209e813b0b1.mp3"
  },
  {
    "text": "Italy is shaped like a boot! Kick!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2733,
    "file": "d56337050994.mp3"
  },
  {
    "text": "Lupa's opera night is coming soon!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3108,
    "file": "06827862e352.mp3"
  },
  {
    "text": "Help friends to fill up Lupa's band!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3149,
    "file": "29998a7db48b.mp3"
  },
  {
    "text": "Awooo!",
    "voice": "lupa",
    "sig": "1200e8d792",
    "ms": 1773,
    "file": "54b7902be1b0.mp3"
  },
  {
    "text": "Hee hee! Ciao!",
    "voice": "lupa",
    "sig": "1200e8d792",
    "ms": 2007,
    "file": "d67809e1584d.mp3"
  },
  {
    "text": "I love to sing!",
    "voice": "lupa",
    "sig": "1200e8d792",
    "ms": 2059,
    "file": "df24e1892407.mp3"
  },
  {
    "text": "Ho ho ho!",
    "voice": "bruno",
    "sig": "f4e1c1c7ae",
    "ms": 1169,
    "file": "4dc7f4976822.mp3"
  },
  {
    "text": "Pizza time!",
    "voice": "bruno",
    "sig": "f4e1c1c7ae",
    "ms": 997,
    "file": "6ed992f6b7a5.mp3"
  },
  {
    "text": "That tickles!",
    "voice": "bruno",
    "sig": "f4e1c1c7ae",
    "ms": 1074,
    "file": "4f12e777559e.mp3"
  },
  {
    "text": "Hello, dear!",
    "voice": "bufala",
    "sig": "dce11cfeb6",
    "ms": 1047,
    "file": "cd9b609a0ef9.mp3"
  },
  {
    "text": "Coo coo! Ciao!",
    "voice": "gino",
    "sig": "94eab962c4",
    "ms": 2198,
    "file": "68bb0b68e241.mp3"
  },
  {
    "text": "I am the emperor.",
    "voice": "cesare",
    "sig": "959ae58ccf",
    "ms": 1291,
    "file": "2b078a1a33d4.mp3"
  },
  {
    "text": "Purrr... hello.",
    "voice": "cesare",
    "sig": "959ae58ccf",
    "ms": 1563,
    "file": "913654052cb7.mp3"
  },
  {
    "text": "Ahem. Bow, please.",
    "voice": "cesare",
    "sig": "959ae58ccf",
    "ms": 2931,
    "file": "e16562000073.mp3"
  },
  {
    "text": "Hoo hoo!",
    "voice": "civetta",
    "sig": "61253580b8",
    "ms": 932,
    "file": "ceae216462f0.mp3"
  },
  {
    "text": "Let's find out!",
    "voice": "civetta",
    "sig": "61253580b8",
    "ms": 993,
    "file": "85d34e285277.mp3"
  },
  {
    "text": "I love science!",
    "voice": "civetta",
    "sig": "61253580b8",
    "ms": 2075,
    "file": "b525d5357284.mp3"
  },
  {
    "text": "Hellooo...",
    "voice": "tortoise",
    "sig": "82816bc927",
    "ms": 2199,
    "file": "e5e42e642c85.mp3"
  },
  {
    "text": "Hee hee! Prickly!",
    "voice": "spina",
    "sig": "cb98c37ff1",
    "ms": 2313,
    "file": "897b5d3d5c9a.mp3"
  },
  {
    "text": "Ciao ciao!",
    "voice": "spina",
    "sig": "cb98c37ff1",
    "ms": 1001,
    "file": "99164b56e054.mp3"
  },
  {
    "text": "Olives! Yum!",
    "voice": "spina",
    "sig": "cb98c37ff1",
    "ms": 1701,
    "file": "34450ab8fa70.mp3"
  },
  {
    "text": "What a lovely kitchen!",
    "voice": "queen",
    "sig": "ceac643602",
    "ms": 1805,
    "file": "58b1954cdfeb.mp3"
  },
  {
    "text": "For the Queen!",
    "voice": "raffaele",
    "sig": "397f188aff",
    "ms": 954,
    "file": "81ba22b4d983.mp3"
  },
  {
    "text": "Welcome to Naples! Pizza was born here!",
    "voice": "lupa",
    "sig": "1200e8d792",
    "ms": 4112,
    "file": "d355afb3af77.mp3"
  },
  {
    "text": "Zio Bruno needs a helper chef!",
    "voice": "lupa",
    "sig": "1200e8d792",
    "ms": 2582,
    "file": "b3caae12c678.mp3"
  },
  {
    "text": "Benvenuta, Chef Kaylee!",
    "voice": "bruno",
    "sig": "f4e1c1c7ae",
    "ms": 2322,
    "file": "e4e8865c1fc6.mp3"
  },
  {
    "text": "Let me tell you the story of the most famous pizza!",
    "voice": "bruno",
    "sig": "f4e1c1c7ae",
    "ms": 3054,
    "file": "2125b41583a9.mp3"
  },
  {
    "text": "Long ago, a queen named Margherita came to Naples.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4339,
    "file": "356696fb6d13.mp3"
  },
  {
    "text": "For the Queen, I will make a special pizza!",
    "voice": "raffaele",
    "sig": "397f188aff",
    "ms": 3535,
    "file": "8feea5570292.mp3"
  },
  {
    "text": "Hello! I would love a pizza, please.",
    "voice": "queen",
    "sig": "ceac643602",
    "ms": 3544,
    "file": "7d4220c19991.mp3"
  },
  {
    "text": "Flick the dough up to spin it!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2316,
    "file": "5c90671e595a.mp3"
  },
  {
    "text": "Again! Flick it up!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1956,
    "file": "72db94da86ae.mp3"
  },
  {
    "text": "Bellissimo! A big round pizza!",
    "voice": "bruno",
    "sig": "f4e1c1c7ae",
    "ms": 3196,
    "file": "bce9f4a732e0.mp3"
  },
  {
    "text": "Bellissimo! A big round pizza!",
    "voice": "raffaele",
    "sig": "397f188aff",
    "ms": 3017,
    "file": "849d26c03c84.mp3"
  },
  {
    "text": "Swirl the ladle to spread the sauce!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3542,
    "file": "ffc2fa8ef21e.mp3"
  },
  {
    "text": "Perfetto! Red tomato sauce!",
    "voice": "bruno",
    "sig": "f4e1c1c7ae",
    "ms": 2625,
    "file": "09fa6f9449cc.mp3"
  },
  {
    "text": "Perfetto! Red tomato sauce!",
    "voice": "raffaele",
    "sig": "397f188aff",
    "ms": 2888,
    "file": "294a7bab3ae0.mp3"
  },
  {
    "text": "Tomatoes love the hot, sunny weather in Italy!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3364,
    "file": "bbcc7a76ee3d.mp3"
  },
  {
    "text": "Put three pieces of white mozzarella on the pizza!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3461,
    "file": "f41bc1b03493.mp3"
  },
  {
    "text": "Now three green basil leaves!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2573,
    "file": "0775b09a6852.mp3"
  },
  {
    "text": "Red, white and green, like the flag of Italy!",
    "voice": "raffaele",
    "sig": "397f188aff",
    "ms": 3548,
    "file": "a05c8cacb987.mp3"
  },
  {
    "text": "Slide the pizza into the oven!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2815,
    "file": "b45a1cd6317b.mp3"
  },
  {
    "text": "This oven is super hot! Pizza bakes in ninety seconds!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4391,
    "file": "f9116057a4e6.mp3"
  },
  {
    "text": "Tap the pizza to turn it!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2535,
    "file": "ab3e36470d0e.mp3"
  },
  {
    "text": "Turn it again!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1358,
    "file": "4827ad6067df.mp3"
  },
  {
    "text": "It is golden! Pull the pizza out!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3370,
    "file": "77e6d0ea65e4.mp3"
  },
  {
    "text": "Tap the pizza to give it to the Queen!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2583,
    "file": "76d7d1e5fe7e.mp3"
  },
  {
    "text": "Buonissima! Red, white and green!",
    "voice": "queen",
    "sig": "ceac643602",
    "ms": 3562,
    "file": "bf67bbb2f28a.mp3"
  },
  {
    "text": "So we call it pizza Margherita!",
    "voice": "bruno",
    "sig": "f4e1c1c7ae",
    "ms": 3003,
    "file": "baab243c2c41.mp3"
  },
  {
    "text": "Mamma mia! Customers!",
    "voice": "bruno",
    "sig": "f4e1c1c7ae",
    "ms": 2474,
    "file": "fee910e4f879.mp3"
  },
  {
    "text": "Fresh mozzarella, from my family's milk!",
    "voice": "bufala",
    "sig": "dce11cfeb6",
    "ms": 2937,
    "file": "75f35981f0ef.mp3"
  },
  {
    "text": "Mozzarella is made from milk. Some comes from buffalo!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4562,
    "file": "598c9255de9b.mp3"
  },
  {
    "text": "Five olives on mine, please!",
    "voice": "bufala",
    "sig": "dce11cfeb6",
    "ms": 2856,
    "file": "8c794b57a677.mp3"
  },
  {
    "text": "Tap the order to start!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2340,
    "file": "c41721efba52.mp3"
  },
  {
    "text": "Mozzarella!",
    "voice": "bruno",
    "sig": "f4e1c1c7ae",
    "ms": 1078,
    "file": "8b0eb3b801b5.mp3"
  },
  {
    "text": "Put five olives on the pizza!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2478,
    "file": "5c3e3942e193.mp3"
  },
  {
    "text": "One!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 606,
    "file": "87ed107b16cf.mp3"
  },
  {
    "text": "Two!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 526,
    "file": "e53b779eaf65.mp3"
  },
  {
    "text": "Three!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 628,
    "file": "b98340c9d88a.mp3"
  },
  {
    "text": "Four!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 698,
    "file": "6ce079912c83.mp3"
  },
  {
    "text": "Five!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 715,
    "file": "8580303dc1c5.mp3"
  },
  {
    "text": "Six!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 764,
    "file": "a38f93f70592.mp3"
  },
  {
    "text": "Seven!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 808,
    "file": "d6374e1efd38.mp3"
  },
  {
    "text": "Eight!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 554,
    "file": "5b0f0f3bdc3a.mp3"
  },
  {
    "text": "Oops, too many! Drag one off the pizza.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3641,
    "file": "6b8d5c13bdb4.mp3"
  },
  {
    "text": "That's the order!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 901,
    "file": "020dc83f1ee9.mp3"
  },
  {
    "text": "Cut it in half! Drag across the pizza.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2990,
    "file": "ce57d257d5bf.mp3"
  },
  {
    "text": "Two halves!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1303,
    "file": "b828f1378203.mp3"
  },
  {
    "text": "Drag all the way across the pizza!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3183,
    "file": "5799842fbb3f.mp3"
  },
  {
    "text": "One half for me, one for my baby!",
    "voice": "bufala",
    "sig": "dce11cfeb6",
    "ms": 3222,
    "file": "11b54f051bba.mp3"
  },
  {
    "text": "Tap the pizza to serve it!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2493,
    "file": "399c9c4ed340.mp3"
  },
  {
    "text": "Buonissima! Grazie!",
    "voice": "bufala",
    "sig": "dce11cfeb6",
    "ms": 2243,
    "file": "cefae69dc52c.mp3"
  },
  {
    "text": "Ciao! Half mushrooms, half olives, please!",
    "voice": "gino",
    "sig": "94eab962c4",
    "ms": 4007,
    "file": "bd9c69e2ab26.mp3"
  },
  {
    "text": "I made this one for you. Watch!",
    "voice": "bruno",
    "sig": "f4e1c1c7ae",
    "ms": 2990,
    "file": "e87686813598.mp3"
  },
  {
    "text": "Mushrooms go on this half!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2618,
    "file": "361f3925344d.mp3"
  },
  {
    "text": "Olives go on that half!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1919,
    "file": "fd076ab08e03.mp3"
  },
  {
    "text": "Put mushrooms on one half and olives on the other!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4104,
    "file": "4a2e20c13444.mp3"
  },
  {
    "text": "Cut it into four slices! Two cuts!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3238,
    "file": "254204448f5b.mp3"
  },
  {
    "text": "Now cut the other way!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2547,
    "file": "900ff880d7dc.mp3"
  },
  {
    "text": "Four slices!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1581,
    "file": "369eac9c55a5.mp3"
  },
  {
    "text": "Four slices, for me and my friends!",
    "voice": "gino",
    "sig": "94eab962c4",
    "ms": 3041,
    "file": "f3a84a0e190e.mp3"
  },
  {
    "text": "Delizioso! Grazie mille!",
    "voice": "gino",
    "sig": "94eab962c4",
    "ms": 2560,
    "file": "6149b4630b39.mp3"
  },
  {
    "text": "When someone says grazie, you say prego!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4259,
    "file": "fc007c134623.mp3"
  },
  {
    "text": "Now make a pizza just for YOU, Chef Kaylee!",
    "voice": "bruno",
    "sig": "f4e1c1c7ae",
    "ms": 3524,
    "file": "d15189dd09e4.mp3"
  },
  {
    "text": "Red sauce or pink sauce?",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2920,
    "file": "c92dbd4cf914.mp3"
  },
  {
    "text": "Red tomato sauce!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1634,
    "file": "9fd8ac059d53.mp3"
  },
  {
    "text": "Pink beet sauce! Yum!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2598,
    "file": "d4e0c6cb4dd4.mp3"
  },
  {
    "text": "Put on anything you like!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2750,
    "file": "14cc50e28cf8.mp3"
  },
  {
    "text": "Mmm... mozzarella...",
    "voice": "cesare",
    "sig": "959ae58ccf",
    "ms": 2570,
    "file": "8e56dc600078.mp3"
  },
  {
    "text": "Uh oh! Tap the sneaky cat!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2517,
    "file": "fbb6141544fe.mp3"
  },
  {
    "text": "Oh. Sorry. Here you go.",
    "voice": "cesare",
    "sig": "959ae58ccf",
    "ms": 3329,
    "file": "5c8bfaafa813.mp3"
  },
  {
    "text": "Tap the check when you like it!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2180,
    "file": "cbebe84db164.mp3"
  },
  {
    "text": "Cut it any way you like!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1979,
    "file": "2a9039a9da89.mp3"
  },
  {
    "text": "Buonissima, Kaylee!",
    "voice": "lupa",
    "sig": "1200e8d792",
    "ms": 2345,
    "file": "246f7f7956e3.mp3"
  },
  {
    "text": "Mozzarella!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1071,
    "file": "0c17a6f4f649.mp3"
  },
  {
    "text": "Basil!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 665,
    "file": "bdf6acc3cb48.mp3"
  },
  {
    "text": "Olive!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 484,
    "file": "55d687b4f89e.mp3"
  },
  {
    "text": "Mushroom!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1002,
    "file": "19fe4b0554c2.mp3"
  },
  {
    "text": "Peperoni! In Italy, that means peppers!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3390,
    "file": "4ba43e054a3d.mp3"
  },
  {
    "text": "Tomato!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 908,
    "file": "72f2c9a8f413.mp3"
  },
  {
    "text": "Great job, Chef Kaylee!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1955,
    "file": "2b0fe32309be.mp3"
  },
  {
    "text": "Everybody loves your pizza!",
    "voice": "bruno",
    "sig": "f4e1c1c7ae",
    "ms": 1957,
    "file": "352ec97da8c6.mp3"
  },
  {
    "text": "Now watch me spin!",
    "voice": "bruno",
    "sig": "f4e1c1c7ae",
    "ms": 1693,
    "file": "c6e07a965385.mp3"
  },
  {
    "text": "Grazie, Chef Kaylee! A chef hat for you!",
    "voice": "bruno",
    "sig": "f4e1c1c7ae",
    "ms": 4419,
    "file": "1350dae2f037.mp3"
  },
  {
    "text": "And my mandolin, for Lupa's band!",
    "voice": "bruno",
    "sig": "f4e1c1c7ae",
    "ms": 2912,
    "file": "1fa0c7475c2c.mp3"
  },
  {
    "text": "Yay! Our first friend for the band!",
    "voice": "lupa",
    "sig": "1200e8d792",
    "ms": 2577,
    "file": "08ef245ca29c.mp3"
  },
  {
    "text": "Ciao, Kaylee! The olives are ready!",
    "voice": "spina",
    "sig": "cb98c37ff1",
    "ms": 2556,
    "file": "d4e2b9b45d21.mp3"
  },
  {
    "text": "Help me pick them for olive oil!",
    "voice": "spina",
    "sig": "cb98c37ff1",
    "ms": 1850,
    "file": "0b38d0c65335.mp3"
  },
  {
    "text": "Drag the rake along the glowing branch!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3078,
    "file": "242228e0b8f6.mp3"
  },
  {
    "text": "Now comb this branch!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2457,
    "file": "74e6264c21b3.mp3"
  },
  {
    "text": "One more branch!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1693,
    "file": "c06b9f965750.mp3"
  },
  {
    "text": "Slide the rake all the way to the end!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3062,
    "file": "dd251770d450.mp3"
  },
  {
    "text": "Eek! They stuck on my quills!",
    "voice": "spina",
    "sig": "cb98c37ff1",
    "ms": 2432,
    "file": "2e88cb46b145.mp3"
  },
  {
    "text": "Oops! Again!",
    "voice": "spina",
    "sig": "cb98c37ff1",
    "ms": 1320,
    "file": "34236ee314c3.mp3"
  },
  {
    "text": "Tap Spina to shake them off!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2827,
    "file": "8265e8e02223.mp3"
  },
  {
    "text": "Hee hee! Into the basket!",
    "voice": "spina",
    "sig": "cb98c37ff1",
    "ms": 1717,
    "file": "4c5898a100ce.mp3"
  },
  {
    "text": "Olives in the net!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1277,
    "file": "7926768fd2f9.mp3"
  },
  {
    "text": "Great combing, Kaylee!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2038,
    "file": "3ee6d0ab4393.mp3"
  },
  {
    "text": "The net is full!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2376,
    "file": "3433076be555.mp3"
  },
  {
    "text": "Olive trees love hot, dry summers!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2936,
    "file": "8b6ed930ebc0.mp3"
  },
  {
    "text": "Into the basket! Grazie!",
    "voice": "spina",
    "sig": "cb98c37ff1",
    "ms": 2179,
    "file": "9649dec875b1.mp3"
  },
  {
    "text": "This olive is green. Tap the sun!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3421,
    "file": "b1608e005850.mp3"
  },
  {
    "text": "Purple! Tap the sun again!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2538,
    "file": "960b06741a84.mp3"
  },
  {
    "text": "Black! Now it is ripe!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2150,
    "file": "05d927f7b1bf.mp3"
  },
  {
    "text": "Green, then purple, then black!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2986,
    "file": "a65086136bd2.mp3"
  },
  {
    "text": "Green goes in the one sun bowl!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2863,
    "file": "2825c964a1b4.mp3"
  },
  {
    "text": "Purple goes in the two sun bowl!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2942,
    "file": "acd161933be5.mp3"
  },
  {
    "text": "Black goes in the three sun bowl!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2997,
    "file": "d2b9ac055372.mp3"
  },
  {
    "text": "Green, purple, black! Well done, Kaylee!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3946,
    "file": "55b59a97f2fa.mp3"
  },
  {
    "text": "Mmm! Let me try one!",
    "voice": "spina",
    "sig": "cb98c37ff1",
    "ms": 2180,
    "file": "8ca75bffcbb5.mp3"
  },
  {
    "text": "Bleh! Bitter!",
    "voice": "spina",
    "sig": "cb98c37ff1",
    "ms": 1770,
    "file": "fcc30c49c10b.mp3"
  },
  {
    "text": "Fresh olives are too bitter!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2767,
    "file": "76a066c2a7d4.mp3"
  },
  {
    "text": "They have to soak first.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2728,
    "file": "a96b32ce05fa.mp3"
  },
  {
    "text": "Welcome to the frantoio, the olive mill!",
    "voice": "spina",
    "sig": "cb98c37ff1",
    "ms": 2754,
    "file": "dae20881e982.mp3"
  },
  {
    "text": "Drop ten olives in the big funnel!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2799,
    "file": "20f738a3a3c4.mp3"
  },
  {
    "text": "Drop an olive in the funnel!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2282,
    "file": "59091b5489e3.mp3"
  },
  {
    "text": "Nine!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 702,
    "file": "995d584b869d.mp3"
  },
  {
    "text": "Ten!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 561,
    "file": "ce43989de1c5.mp3"
  },
  {
    "text": "It takes lots of olives to make oil!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2821,
    "file": "b3f5d43acc50.mp3"
  },
  {
    "text": "Here comes the big stone wheel!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2366,
    "file": "d3fa2677bae5.mp3"
  },
  {
    "text": "Squish, squish, squish!",
    "voice": "spina",
    "sig": "cb98c37ff1",
    "ms": 1742,
    "file": "977a1892e442.mp3"
  },
  {
    "text": "Look! Golden olive oil!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2536,
    "file": "3148b69213ce.mp3"
  },
  {
    "text": "Hold the jug to pour! Fill it all the way!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4018,
    "file": "6db67ba8c916.mp3"
  },
  {
    "text": "Full! All the way to the top!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2610,
    "file": "b64e32aa1dc5.mp3"
  },
  {
    "text": "Now fill it halfway!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2315,
    "file": "93b0d18f54a2.mp3"
  },
  {
    "text": "A little more, to the line!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2080,
    "file": "20017c6b7a53.mp3"
  },
  {
    "text": "Hee hee! Just a taste!",
    "voice": "spina",
    "sig": "cb98c37ff1",
    "ms": 1514,
    "file": "5983b7939919.mp3"
  },
  {
    "text": "Halfway full!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1378,
    "file": "ba2c24f40e47.mp3"
  },
  {
    "text": "Olive oil goes on almost everything in Italy!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3776,
    "file": "e7e5f3459973.mp3"
  },
  {
    "text": "Bruschetta for everyone!",
    "voice": "spina",
    "sig": "cb98c37ff1",
    "ms": 1514,
    "file": "49c3df0ee6ec.mp3"
  },
  {
    "text": "Crunch! Buonissima!",
    "voice": "spina",
    "sig": "cb98c37ff1",
    "ms": 2355,
    "file": "018c49494beb.mp3"
  },
  {
    "text": "And my tambourine, for Lupa's band!",
    "voice": "spina",
    "sig": "cb98c37ff1",
    "ms": 2578,
    "file": "2411525ac714.mp3"
  },
  {
    "text": "Tap the tambourine!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1768,
    "file": "3e1c8775df98.mp3"
  },
  {
    "text": "Let's dance the pizzica!",
    "voice": "spina",
    "sig": "cb98c37ff1",
    "ms": 1616,
    "file": "bc0700c53841.mp3"
  },
  {
    "text": "Yay! A tambourine for the band!",
    "voice": "lupa",
    "sig": "1200e8d792",
    "ms": 3143,
    "file": "fab0b41391e8.mp3"
  },
  {
    "text": "Oh no! It's dry!",
    "voice": "lupa",
    "sig": "1200e8d792",
    "ms": 2057,
    "file": "503935853747.mp3"
  },
  {
    "text": "Where did the water go?",
    "voice": "lupa",
    "sig": "1200e8d792",
    "ms": 1827,
    "file": "7193a28e3c9b.mp3"
  },
  {
    "text": "Tap the hill and listen!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2067,
    "file": "978cf5a83c1c.mp3"
  },
  {
    "text": "Shh! I hear water!",
    "voice": "lupa",
    "sig": "1200e8d792",
    "ms": 2468,
    "file": "ed904381272d.mp3"
  },
  {
    "text": "It's getting louder!",
    "voice": "lupa",
    "sig": "1200e8d792",
    "ms": 1351,
    "file": "ab0d1d7da71c.mp3"
  },
  {
    "text": "Tap the rocks!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1093,
    "file": "174b35c1ab1a.mp3"
  },
  {
    "text": "Acqua! You found water!",
    "voice": "lupa",
    "sig": "1200e8d792",
    "ms": 2347,
    "file": "c52cbfff6891.mp3"
  },
  {
    "text": "Long ago, a girl helped the Romans find water.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3738,
    "file": "acc3ddacaca7.mp3"
  },
  {
    "text": "Today, that girl is YOU, Kaylee!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3292,
    "file": "2905309a41e3.mp3"
  },
  {
    "text": "Build a water bridge to Rome!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2546,
    "file": "ad5c1144510e.mp3"
  },
  {
    "text": "Drag the arch that fits each gap!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3041,
    "file": "891aeb096397.mp3"
  },
  {
    "text": "It fits!",
    "voice": "lupa",
    "sig": "1200e8d792",
    "ms": 1002,
    "file": "7ae6f075e02f.mp3"
  },
  {
    "text": "Perfetto!",
    "voice": "lupa",
    "sig": "1200e8d792",
    "ms": 879,
    "file": "2a763c71cbf0.mp3"
  },
  {
    "text": "Brava, Kaylee!",
    "voice": "lupa",
    "sig": "1200e8d792",
    "ms": 1544,
    "file": "9c9737ef4036.mp3"
  },
  {
    "text": "Water only flows downhill!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2516,
    "file": "4441dc0e3fce.mp3"
  },
  {
    "text": "Try the glowing arch!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1682,
    "file": "44d79d965c16.mp3"
  },
  {
    "text": "Now tap an arch!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1686,
    "file": "45220c5d071f.mp3"
  },
  {
    "text": "Now all the way to Rome! Look closely!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4203,
    "file": "f4a4a73fc931.mp3"
  },
  {
    "text": "The Romans called a water bridge an aqueduct!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3204,
    "file": "320cdb0c98f3.mp3"
  },
  {
    "text": "Tap the spring to turn on the water!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2177,
    "file": "aa4d726ddf11.mp3"
  },
  {
    "text": "Follow the water with your finger!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2703,
    "file": "68f9ee206dda.mp3"
  },
  {
    "text": "The water is going to Rome!",
    "voice": "lupa",
    "sig": "1200e8d792",
    "ms": 2349,
    "file": "5de3a0c7ee0b.mp3"
  },
  {
    "text": "Bellissima! The fountain is full!",
    "voice": "lupa",
    "sig": "1200e8d792",
    "ms": 3414,
    "file": "e7f84cbe43ff.mp3"
  },
  {
    "text": "The Romans built this water bridge!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2264,
    "file": "bce9fd0a7dd1.mp3"
  },
  {
    "text": "That was 2,000 years ago!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3053,
    "file": "05e4963bd410.mp3"
  },
  {
    "text": "And it still fills the fountain today!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2437,
    "file": "d42ce4a12263.mp3"
  },
  {
    "text": "Flick the coin up into the fountain!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2551,
    "file": "ff90e6983781.mp3"
  },
  {
    "text": "Swipe up on the coin!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2125,
    "file": "56d253be6731.mp3"
  },
  {
    "text": "One more coin!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1547,
    "file": "54638c568f7d.mp3"
  },
  {
    "text": "Now you will come back to Rome one day, Kaylee!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2830,
    "file": "52f03d4cccfd.mp3"
  },
  {
    "text": "My turn!",
    "voice": "lupa",
    "sig": "1200e8d792",
    "ms": 953,
    "file": "f08b15e69501.mp3"
  },
  {
    "text": "I wish I could sing!",
    "voice": "lupa",
    "sig": "1200e8d792",
    "ms": 1553,
    "file": "eebb61b8cb6f.mp3"
  },
  {
    "text": "A wishing star!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1363,
    "file": "4142301d6283.mp3"
  },
  {
    "text": "It waits for Lupa's big night.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3124,
    "file": "affe6e3d8124.mp3"
  },
  {
    "text": "Coins from the fountain help people who need it.",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3424,
    "file": "eada6e7250dd.mp3"
  },
  {
    "text": "I am Cesare, Emperor of the Colosseum!",
    "voice": "cesare",
    "sig": "959ae58ccf",
    "ms": 3771,
    "file": "58514146c8b3.mp3"
  },
  {
    "text": "Tonight: a surprise show!",
    "voice": "cesare",
    "sig": "959ae58ccf",
    "ms": 2546,
    "file": "10102d015be0.mp3"
  },
  {
    "text": "But it is so hot!",
    "voice": "cesare",
    "sig": "959ae58ccf",
    "ms": 2220,
    "file": "2ff92b5b7022.mp3"
  },
  {
    "text": "Rome is hot and sunny in summer!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3418,
    "file": "16074eda35c8.mp3"
  },
  {
    "text": "Pull the rope down to make shade!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3133,
    "file": "6927d45373db.mp3"
  },
  {
    "text": "Pull the next rope!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2088,
    "file": "9fb7090a9caa.mp3"
  },
  {
    "text": "One more rope!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1813,
    "file": "dcd1e02eaabe.mp3"
  },
  {
    "text": "Drag the rope handle all the way down!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2869,
    "file": "796d21324eeb.mp3"
  },
  {
    "text": "Ahh, shade!",
    "voice": "cesare",
    "sig": "959ae58ccf",
    "ms": 1595,
    "file": "780e0bfe91d6.mp3"
  },
  {
    "text": "Ahh, much better!",
    "voice": "cesare",
    "sig": "959ae58ccf",
    "ms": 2365,
    "file": "4e1ef2ef1fbb.mp3"
  },
  {
    "text": "Ahh! Grazie!",
    "voice": "cesare",
    "sig": "959ae58ccf",
    "ms": 1754,
    "file": "2fa2777387ec.mp3"
  },
  {
    "text": "Long ago, sailors pulled the shade ropes!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3851,
    "file": "61b9e71cd71e.mp3"
  },
  {
    "text": "Under the floor are secret tunnels and elevators!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3809,
    "file": "73a767d0264b.mp3"
  },
  {
    "text": "Romans wrote numbers with lines!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2212,
    "file": "8749db9a573c.mp3"
  },
  {
    "text": "Door one!",
    "voice": "cesare",
    "sig": "959ae58ccf",
    "ms": 2914,
    "file": "e8ff9db01e98.mp3"
  },
  {
    "text": "Door two!",
    "voice": "cesare",
    "sig": "959ae58ccf",
    "ms": 1123,
    "file": "1e5ff3d50ea3.mp3"
  },
  {
    "text": "Door three!",
    "voice": "cesare",
    "sig": "959ae58ccf",
    "ms": 1504,
    "file": "cac9b24609eb.mp3"
  },
  {
    "text": "Door four!",
    "voice": "cesare",
    "sig": "959ae58ccf",
    "ms": 1241,
    "file": "4e47a19ae6dc.mp3"
  },
  {
    "text": "Door five!",
    "voice": "cesare",
    "sig": "959ae58ccf",
    "ms": 1391,
    "file": "23c57c0a995e.mp3"
  },
  {
    "text": "Tap the door with the right number!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1956,
    "file": "9cc7caf6f529.mp3"
  },
  {
    "text": "One line. One!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1606,
    "file": "3e5155861c64.mp3"
  },
  {
    "text": "One, two lines. Two!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2660,
    "file": "2da106d651d5.mp3"
  },
  {
    "text": "One, two, three lines. Three!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3741,
    "file": "6c4ea2e5b4d1.mp3"
  },
  {
    "text": "Four is one line, then a V!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2762,
    "file": "6f90c24348f9.mp3"
  },
  {
    "text": "Five looks like a V!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2119,
    "file": "b229a20f244c.mp3"
  },
  {
    "text": "Pull the lever down!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2015,
    "file": "4a71ac6087f2.mp3"
  },
  {
    "text": "Drag the lever all the way down!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2515,
    "file": "26ec031a733a.mp3"
  },
  {
    "text": "Up goes the elevator!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1904,
    "file": "1231e0f4f100.mp3"
  },
  {
    "text": "Ta-da! Olive juggling!",
    "voice": "spina",
    "sig": "cb98c37ff1",
    "ms": 1821,
    "file": "295952fb88e3.mp3"
  },
  {
    "text": "Ta-da! The spinning pigeon!",
    "voice": "gino",
    "sig": "94eab962c4",
    "ms": 2605,
    "file": "766741c811a0.mp3"
  },
  {
    "text": "Ta... daaa...",
    "voice": "tortoise",
    "sig": "82816bc927",
    "ms": 2476,
    "file": "c342db07d4f2.mp3"
  },
  {
    "text": "Ta-da! Pizza spin!",
    "voice": "bruno",
    "sig": "f4e1c1c7ae",
    "ms": 2122,
    "file": "43314eac31f6.mp3"
  },
  {
    "text": "Ta-da! Awoooo!",
    "voice": "lupa",
    "sig": "1200e8d792",
    "ms": 2073,
    "file": "4c1e19a73ad4.mp3"
  },
  {
    "text": "A very, very slow bow!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3890,
    "file": "9f6967f4f33b.mp3"
  },
  {
    "text": "Now the big doors: four and five!",
    "voice": "cesare",
    "sig": "959ae58ccf",
    "ms": 3225,
    "file": "507e7389de93.mp3"
  },
  {
    "text": "V is five! Just like you, Kaylee!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4045,
    "file": "38e6169c0707.mp3"
  },
  {
    "text": "Everybody, up!",
    "voice": "cesare",
    "sig": "959ae58ccf",
    "ms": 1299,
    "file": "d7f72cf479cd.mp3"
  },
  {
    "text": "Swipe across the crowd to make a wave!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 3116,
    "file": "0e51d89c5eaf.mp3"
  },
  {
    "text": "Again! Make a wave!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2103,
    "file": "6ab41583f032.mp3"
  },
  {
    "text": "Bravissimi! What a show!",
    "voice": "cesare",
    "sig": "959ae58ccf",
    "ms": 2467,
    "file": "8aab9cb4cecf.mp3"
  },
  {
    "text": "The Colosseum is almost 2,000 years old!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 4121,
    "file": "e506bb1d2fb1.mp3"
  },
  {
    "text": "Grazie, Kaylee. I bow to you.",
    "voice": "cesare",
    "sig": "959ae58ccf",
    "ms": 3153,
    "file": "826ede3a842d.mp3"
  },
  {
    "text": "My Roman horn, for Lupa's band!",
    "voice": "cesare",
    "sig": "959ae58ccf",
    "ms": 2643,
    "file": "3eeb232a8a89.mp3"
  },
  {
    "text": "Tap the horn!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1507,
    "file": "756932a0d7ef.mp3"
  },
  {
    "text": "Yay! A horn for the band!",
    "voice": "lupa",
    "sig": "1200e8d792",
    "ms": 2515,
    "file": "245678b7676d.mp3"
  },
  {
    "text": "Ciao, Kaylee! In Venice, the streets are water!",
    "voice": "gino",
    "sig": "94eab962c4",
    "ms": 4683,
    "file": "32cbf74d2ac6.mp3"
  },
  {
    "text": "Grab my gondola!",
    "voice": "gino",
    "sig": "94eab962c4",
    "ms": 1733,
    "file": "d63770489ff5.mp3"
  },
  {
    "text": "Pick a boat!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1109,
    "file": "f8eb77c83b67.mp3"
  },
  {
    "text": "A real gondola! Bellissima!",
    "voice": "gino",
    "sig": "94eab962c4",
    "ms": 3190,
    "file": "ab190a7d21f0.mp3"
  },
  {
    "text": "A swan boat! So fancy!",
    "voice": "gino",
    "sig": "94eab962c4",
    "ms": 2919,
    "file": "fed00b6da80e.mp3"
  },
  {
    "text": "A bathtub? Ha ha! Splish splash!",
    "voice": "gino",
    "sig": "94eab962c4",
    "ms": 4049,
    "file": "9ab3022b743e.mp3"
  },
  {
    "text": "A pizza boat! Delizioso!",
    "voice": "gino",
    "sig": "94eab962c4",
    "ms": 3377,
    "file": "9ad6c9cf5800.mp3"
  },
  {
    "text": "Pull the boat!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1258,
    "file": "432b800dd655.mp3"
  },
  {
    "text": "Wheee!",
    "voice": "gino",
    "sig": "94eab962c4",
    "ms": 1467,
    "file": "35b9e7f78287.mp3"
  },
  {
    "text": "Boing! Mamma mia!",
    "voice": "gino",
    "sig": "94eab962c4",
    "ms": 2238,
    "file": "ae2b69a233ac.mp3"
  },
  {
    "text": "Ooh, I'm dizzy!",
    "voice": "gino",
    "sig": "94eab962c4",
    "ms": 2307,
    "file": "705ac0cccc41.mp3"
  },
  {
    "text": "Coo coo! That tickles!",
    "voice": "gino",
    "sig": "94eab962c4",
    "ms": 2308,
    "file": "b0800364eba7.mp3"
  },
  {
    "text": "Look! A friend is waving!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2283,
    "file": "49af85ab2903.mp3"
  },
  {
    "text": "Two friends! Who goes first?",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2604,
    "file": "9604cde9ddeb.mp3"
  },
  {
    "text": "Drive close to the door!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 2155,
    "file": "fc9a03720270.mp3"
  },
  {
    "text": "It's to the LEFT!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1258,
    "file": "ef8b53585903.mp3"
  },
  {
    "text": "It's to the RIGHT!",
    "voice": "sparkle",
    "sig": "ed7dbdac3d",
    "ms": 1426,
    "file": "e197c568a171.mp3"
  },
  {
    "text": "To the pink house, please!",
    "voice": "lupa",
    "sig": "1200e8d792",
    "ms": 1880,
    "file": "7519085ee51f.mp3"
  },
  {
