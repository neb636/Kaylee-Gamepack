{
  "name": "kaylee-gamepack-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Local character, camera and feel studio for Kaylee\u2019s Gamepack",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dev:renderer": "vite --host 127.0.0.1 --port 5175 --strictPort",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "lint": "eslint .",
    "test": "npm run build:electron && node --test tests/*.test.mjs",
    "start": "node scripts/dev.mjs",
    "qa:composer": "node scripts/qa-composer.mjs",
    "qa:images": "node scripts/qa-image-generator.mjs",
    "postinstall": "node node_modules/electron/install.js && electron-rebuild -f -w node-pty",
    "qa:labs": "node scripts/qa-labs.mjs"
  },
  "dependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^5.5.0",
    "node-pty": "^1.0.0",
    "react": "^19.1.1",
    "react-aria-components": "^1.12.1",
    "react-dom": "^19.1.1",
    "react-resizable-panels": "^2.1.9",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^45.1.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "playwright": "^1.55.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vite": "^7.1.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
